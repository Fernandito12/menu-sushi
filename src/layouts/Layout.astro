---
interface Props { title?: string; }
const { title = 'TAKUMI OMAKASE — 匠' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F4EF" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Noto+Sans+JP:wght@400;500&family=Noto+Serif+JP:wght@700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="kanji-watermark-layer" aria-hidden="true">
      <span class="watermark watermark-left" data-parallax="left" lang="ja">匠</span>
      <span class="watermark watermark-right" data-parallax="right" lang="ja">鮨</span>
      <span class="watermark watermark-center" data-parallax="center" lang="ja">
        <span class="watermark-category is-active" data-watermark-category="default">旬</span>
        <span class="watermark-category" data-watermark-category="nigiri">握り</span>
        <span class="watermark-category" data-watermark-category="maki">巻き</span>
        <span class="watermark-category" data-watermark-category="sashimi">刺身</span>
      </span>
      <span class="watermark watermark-top" data-parallax="top" lang="ja">鮮</span>
      <span class="watermark watermark-bottom" data-parallax="bottom" lang="ja">旨</span>
    </div>
    <div class="cursor" aria-hidden="true">
      <span class="cursor-dot"></span>
      <span class="cursor-label">
        <span data-cursor-label="cover">VER / <i lang="ja">注文</i></span>
        <span data-cursor-label="close">CERRAR / <i lang="ja">閉じる</i></span>
      </span>
    </div>
    <div class="paper-grain" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <filter id="rice-paper"><feTurbulence type="fractalNoise" baseFrequency=".78" numOctaves="3" stitchTiles="stitch" /></filter>
        <rect width="100%" height="100%" filter="url(#rice-paper)" opacity=".24" />
      </svg>
    </div>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --paper: #F7F4EF;
    --sheet: #FFFEFB;
    --ink: #191B1B;
    --cobalt: #244E8A;
    --rule: rgba(25, 27, 27, .18);
    --ease: cubic-bezier(.2, .72, .18, 1);
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { min-width: 320px; background: var(--paper); }
  body { margin: 0; min-height: 100vh; color: var(--ink); background: var(--paper); font-family: 'Inter Tight', sans-serif; }
  .kanji-watermark-layer { position: fixed; z-index: 0; inset: 0; overflow: hidden; pointer-events: none; user-select: none; mix-blend-mode: multiply; }
  .watermark { position: absolute; display: block; color: var(--ink); opacity: .045; font: 700 clamp(18vw, 32vw, 450px)/.88 'Noto Serif JP', 'Noto Sans JP', serif; writing-mode: vertical-rl; will-change: transform; }
  .watermark-left { top: -10%; left: -3%; color: var(--cobalt); }
  .watermark-right { top: 4%; right: -4%; color: var(--ink); }
  .watermark-top { top: -14%; left: 38%; opacity: .035; }
  .watermark-bottom { right: 31%; bottom: -29%; color: var(--cobalt); opacity: .035; }
  .watermark-center { top: 50%; left: 50%; display: grid; place-items: center; transform: translate(-50%, -50%); color: var(--ink); opacity: .05; }
  .watermark-category { grid-area: 1 / 1; opacity: 0; transition: opacity 850ms var(--ease); }
  .watermark-category.is-active { opacity: 1; }
  .paper-grain { position: fixed; inset: 0; z-index: 20; pointer-events: none; opacity: .55; mix-blend-mode: multiply; }
  .paper-grain svg { display: block; width: 100%; height: 100%; }
  .cursor { --cursor-x: 50vw; --cursor-y: 50vh; --cursor-scale: 1; position: fixed; z-index: 100; top: 0; left: 0; width: 58px; height: 58px; display: grid; place-items: center; border: 1px solid rgba(36, 78, 138, .52); border-radius: 50%; color: var(--ink); pointer-events: none; opacity: 0; transform: translate3d(var(--cursor-x), var(--cursor-y), 0) translate(-50%, -50%) scale(var(--cursor-scale)); transition: opacity .18s ease, color .18s ease, background-color .18s ease, border-color .18s ease, width .3s ease, height .3s ease; }
  .cursor-dot { width: 4px; height: 4px; border-radius: 50%; background: currentColor; }
  .cursor-label { display: none; flex-direction: column; align-items: center; gap: 2px; font-size: 8px; font-weight: 600; letter-spacing: .09em; white-space: nowrap; }
  .cursor-label [data-cursor-label="close"] { display: none; }
  .cursor-label i { font: 10px 'Noto Sans JP', sans-serif; letter-spacing: 0; }
  .cursor--spine { border-color: rgba(36, 78, 138, .28); }
  .cursor--button { border-color: rgba(36, 78, 138, .65); background: rgba(247, 244, 239, .9); }
  .cursor--button .cursor-dot { display: none; }
  .cursor--open { border-color: #1F3FB0; background: #1F3FB0; color: #fff; }
  .cursor--open .cursor-dot { display: none; }
  .cursor--open .cursor-label, .cursor--modal-close .cursor-label { display: flex; }
  .cursor--modal { width: 24px; height: 24px; border-color: rgba(25, 27, 27, .28); color: var(--ink); opacity: .52; }
  .cursor--modal .cursor-label { display: none; }
  .cursor--modal-close { width: 76px; height: 76px; border-color: var(--cobalt); background: var(--paper); color: var(--cobalt); opacity: .96; }
  .cursor--modal-close .cursor-dot, .cursor--modal-cta .cursor-dot { display: none; }
  .cursor--modal-close [data-cursor-label="cover"] { display: none; }
  .cursor--modal-close [data-cursor-label="close"] { display: block; }
  .cursor--modal-close .cursor-label { display: block; font-size: 8px; }
  .cursor--modal-cta { width: 82px; height: 82px; border-color: #1F3FB0; background: #1F3FB0; color: #fff; opacity: .94; animation: cursor-pulse 1.7s ease-in-out infinite; }
  .cursor--modal-cta .cursor-label { display: none; }
  .cursor--returning { transition: opacity .3s ease, color .3s ease, background-color .3s ease, border-color .3s ease, width .3s ease, height .3s ease; }
  @keyframes cursor-pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(31, 63, 176, .18); } 50% { box-shadow: 0 0 0 10px rgba(31, 63, 176, 0); } }
  @media (pointer: fine) { body, body button { cursor: none; } }
  @media (pointer: coarse) { .cursor { display: none; } }
  @media (prefers-reduced-motion: reduce) { .watermark-category, .cursor--returning { transition-duration: .01ms; } .cursor--modal-cta { animation: none; } }
</style>
