---
interface Props { title?: string; }
const { title = 'TAKUMI OMAKASE — 匠' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F4EF" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Noto+Sans+JP:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="kanji-atmosphere" aria-hidden="true">
      <span class="kanji-one" lang="ja">匠</span>
      <span class="kanji-two" lang="ja">鮨</span>
      <span class="kanji-three" lang="ja">味</span>
      <span class="kanji-four" lang="ja">旬</span>
    </div>
    <div class="cursor" aria-hidden="true">
      <span class="cursor-dot"></span>
      <span class="cursor-label">VER / <i lang="ja">注文</i></span>
    </div>
    <div class="paper-grain" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <filter id="rice-paper"><feTurbulence type="fractalNoise" baseFrequency=".78" numOctaves="3" stitchTiles="stitch" /></filter>
        <rect width="100%" height="100%" filter="url(#rice-paper)" opacity=".24" />
      </svg>
    </div>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --paper: #F7F4EF;
    --sheet: #FFFEFB;
    --ink: #191B1B;
    --cobalt: #244E8A;
    --rule: rgba(25, 27, 27, .18);
    --ease: cubic-bezier(.2, .72, .18, 1);
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { min-width: 320px; background: var(--paper); }
  body { margin: 0; min-height: 100vh; color: var(--ink); background: var(--paper); font-family: 'Inter Tight', sans-serif; }
  .kanji-atmosphere { position: fixed; z-index: 0; inset: 0; overflow: hidden; pointer-events: none; user-select: none; }
  .kanji-atmosphere span { position: absolute; color: var(--cobalt); opacity: .055; font: 500 clamp(100px, 15vw, 220px)/1 'Noto Sans JP', sans-serif; }
  .kanji-one { top: 8%; left: 7%; transform: rotate(-9deg); }
  .kanji-two { top: 22%; right: 9%; transform: rotate(8deg); }
  .kanji-three { bottom: 8%; left: 19%; transform: rotate(5deg); }
  .kanji-four { right: 15%; bottom: 12%; transform: rotate(-8deg); }
  .paper-grain { position: fixed; inset: 0; z-index: 20; pointer-events: none; opacity: .55; mix-blend-mode: multiply; }
  .paper-grain svg { display: block; width: 100%; height: 100%; }
  .cursor { --cursor-x: 50vw; --cursor-y: 50vh; --cursor-scale: 1; position: fixed; z-index: 60; top: 0; left: 0; width: 58px; height: 58px; display: grid; place-items: center; border: 1px solid rgba(36, 78, 138, .52); border-radius: 50%; color: var(--ink); pointer-events: none; opacity: 0; transform: translate3d(var(--cursor-x), var(--cursor-y), 0) translate(-50%, -50%) scale(var(--cursor-scale)); transition: opacity .18s ease, color .18s ease, background-color .18s ease, border-color .18s ease; }
  .cursor-dot { width: 4px; height: 4px; border-radius: 50%; background: currentColor; }
  .cursor-label { display: none; flex-direction: column; align-items: center; gap: 2px; font-size: 8px; font-weight: 600; letter-spacing: .09em; }
  .cursor-label i { font: 10px 'Noto Sans JP', sans-serif; letter-spacing: 0; }
  .cursor--spine { border-color: rgba(36, 78, 138, .28); }
  .cursor--button { border-color: rgba(36, 78, 138, .65); background: rgba(247, 244, 239, .9); }
  .cursor--button .cursor-dot { display: none; }
  .cursor--open { border-color: #1F3FB0; background: #1F3FB0; color: #fff; }
  .cursor--open .cursor-dot { display: none; }
  .cursor--open .cursor-label { display: flex; }
  @media (pointer: fine) { body, body button { cursor: none; } }
  @media (pointer: coarse) { .cursor { display: none; } }
</style>
