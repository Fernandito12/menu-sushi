---
import { sushiData } from '../data/sushiData';
import SushiDetailModal from './SushiDetailModal.astro';
const tapes = Array.from({ length: 3 }, (_, turn) => sushiData.map((item, index) => ({ item, index: turn * sushiData.length + index })) ).flat();
const categories = [
  { label: 'TODOS', value: 'all' },
  { label: 'NIGIRI', value: 'nigiri' },
  { label: 'MAKI', value: 'maki' },
  { label: 'SASHIMI', value: 'sashimi' },
  { label: 'ESPECIALES', value: 'specials' },
];
const categoryNames: Record<string, string> = {
  nigiri: 'Nigiri', maki: 'Maki', sashimi: 'Sashimi', specials: 'Especiales',
};
const cropStyle = (crop: { x: number; y: number; w: number; h: number }) =>
  `--cx:${crop.x};--cy:${crop.y};--cw:${crop.w};--ch:${crop.h}`;
const faceStyle = (crop: { x: number; y: number; w: number; h: number }, imageUrl: string) =>
  `${cropStyle(crop)};--card-image:url("${imageUrl}")`;
---
<section class="shelf-section" aria-label="Menú interactivo de TAKUMI OMAKASE">
  <header class="topbar">
    <a class="brand" href="#menu" aria-label="Takumi Omakase, inicio">
      <span class="brand-name">TAKUMI OMAKASE</span><span class="brand-kanji" lang="ja">匠</span>
    </a>
    <nav class="categories" aria-label="Categorías del menú">
      {categories.map((category, i) => (
        <button class:list={['category', 'btn', { active: i === 0 }]} type="button" data-category={category.value} aria-pressed={i === 0 ? 'true' : 'false'}>{category.label}</button>
      ))}
    </nav>
    <span class="edition">MENÚ · 01</span>
  </header>

  <main class="stage-wrap" id="menu">
    <p class="eyebrow">季節のおまかせ · SELECCIÓN DEL CHEF</p>
    <h1>Una pieza, un momento.</h1>
    <div class="shelf-section__viewport">
      <div class="stage">
        {tapes.map(({ item, index }) => (
          <article class="tape" data-index={index} data-id={item.id} data-category={item.category} data-title={item.title} data-title-es={item.titleEs} data-romaji={item.romaji} data-kanji={item.kanji} data-price={item.price} data-image={item.images[0]} data-images={JSON.stringify(item.images)} data-synopsis={item.synopsis} data-ingredients={item.ingredients.join(' · ')} data-allergens={item.allergens.join('|')} data-sake-pairing={item.sakePairing} tabindex={index === 0 ? 0 : -1} role="button" style={`--i:${index};--turn:${Math.floor(index / sushiData.length)};`} aria-label={`${item.title}, $${item.price} MXN`}>
            <div class="sp spine" style={faceStyle(item.spineCrop, item.images[0])} aria-hidden="true">
              <span class="sp-title">{item.title}</span><span class="sp-kanji" lang="ja">{item.kanji}</span>
            </div>
            <div class="cv" data-cover style={faceStyle(item.coverCrop, item.images[0])}>
              <div class="cover-copy">
                <span class="cover-category">{categoryNames[item.category]}</span>
                <h2>{item.title}</h2>
                <span class="cover-romaji">{item.romaji}</span>
                <span class="cover-price">${item.price} <small>MXN</small></span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
    <div class="shelf" aria-hidden="true"></div>
    <p class="stage-hint">ELIGE UNA PIEZA <span>✳</span> 12 ESPECIALIDADES</p>
    <div class="caption-mask" data-caption aria-live="polite" aria-atomic="true">
      <div class="caption-content">
        <h2 class="caption-title">{sushiData[0].titleEs}</h2>
        <p class="caption-subtitle">{sushiData[0].romaji} <span lang="ja">{sushiData[0].kanji}</span></p>
        <p class="caption-price">${sushiData[0].price} <small>MXN</small></p>
      </div>
    </div>
  </main>

  <footer class="footer">
    <span>EDO. CONTEMPORÁNEO · CDMX</span>
    <span class="footer-kanji" lang="ja">丁寧に、心を込めて。</span>
    <span>DESLIZA PARA EXPLORAR <b>↗</b></span>
  </footer>
</section>

<SushiDetailModal />

<script>
  const shelf = document.querySelector<HTMLElement>('.shelf-section');
  const stage = shelf?.querySelector<HTMLElement>('.stage');
  const cards = Array.from(shelf?.querySelectorAll<HTMLElement>('.tape') ?? []);
  const tabs = Array.from(shelf?.querySelectorAll<HTMLButtonElement>('.category') ?? []);

  if (shelf && stage && cards.length) {
    const count = cards.length;
    const mod = (value: number, length: number) => ((value % length) + length) % length;
    const shortestDistance = (from: number, to: number) => mod(to - from + count / 2, count) - count / 2;
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
    const B = (r: number) => (r + Math.sin(Math.PI * r) / Math.PI) / 2;
    const cursor = document.querySelector<HTMLElement>('.cursor');
    const watermarkLayer = document.querySelector<HTMLElement>('.kanji-watermark-layer');
    const watermarkCenter = watermarkLayer?.querySelector<HTMLElement>('[data-parallax="center"]');
    const watermarkCategoryLayers = Array.from(watermarkCenter?.querySelectorAll<HTMLElement>('[data-watermark-category]') ?? []);
    const watermarkParallax = Array.from(watermarkLayer?.querySelectorAll<HTMLElement>('[data-parallax]') ?? []);
    const shelfShadow = shelf.querySelector<HTMLElement>('.shelf');
    const caption = shelf.querySelector<HTMLElement>('[data-caption]');
    let currentCaptionContent = caption?.querySelector<HTMLElement>('.caption-content') ?? null;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Warm every dish photo before it becomes the active cover.
    const imageUrls = new Set(cards.flatMap((card) => {
      try { return JSON.parse(card.dataset.images ?? '[]') as string[]; }
      catch { return card.dataset.image ? [card.dataset.image] : []; }
    }));
    imageUrls.forEach((url) => {
      const image = new Image();
      image.decoding = 'async';
      image.src = url;
    });

    // Use the same rendered card height as the geometry source for all dimensions.
    const probe = document.createElement('div');
    probe.className = 'tape geometry-probe';
    probe.setAttribute('aria-hidden', 'true');
    stage.append(probe);
    const H = probe.getBoundingClientRect().height;
    probe.remove();

    let cardHeight = H || Math.min(330, Math.max(230, window.innerHeight * 0.38));
    let mobileLayout = window.matchMedia('(max-width: 767px)').matches;
    let ws = Math.max(mobileLayout ? 18 : 16, cardHeight * (mobileLayout ? 0.17 : 0.14));
    let d = Math.max(mobileLayout ? 125 : 140, cardHeight * (mobileLayout ? 0.88 : 0.68));
    shelf.style.setProperty('--H', `${cardHeight}px`);
    shelf.style.setProperty('--ws', `${ws}px`);
    shelf.style.setProperty('--d', `${d}px`);

    let s = 0;
    let T = 0;
    let lastTime = 0;
    let cursorX = window.innerWidth / 2;
    let cursorY = window.innerHeight / 2;
    let pointerX = cursorX;
    let pointerY = cursorY;
    let cursorMode = 'default';
    let cursorScale = 1;
    let isOpen = false;
    let cursorReturnStart = 0;
    let cursorReturnFrom = 1;
    let lastCaptionIndex = 0;
    let pointerStartX = 0;
    let pointerStartT = 0;
    let dragging = false;
    let dragPointerType = 'mouse';
    let dragMoved = false;
    let lastDragX = 0;
    let lastDragTime = 0;
    let inertiaVelocity = 0;
    let inertiaOrigin = 0;
    let inertiaActive = false;
    let frame = 0;
    let lastWatermarkCategory = '';

    const dispatchOpenDetail = (card: HTMLElement) => {
      if (!card.classList.contains('open')) return;
      const cover = card.querySelector<HTMLElement>('[data-cover]');
      if (!cover) return;
      const rect = cover.getBoundingClientRect();
      window.dispatchEvent(new CustomEvent('takumi:open-detail', {
        detail: {
          dish: {
            id: card.dataset.id ?? '',
            title: card.dataset.title ?? '',
            titleEs: card.dataset.titleEs ?? card.dataset.title ?? '',
            romaji: card.dataset.romaji ?? '',
            kanji: card.dataset.kanji ?? '',
            category: card.dataset.category ?? '',
            price: card.dataset.price ?? '',
            images: (() => {
              try { return JSON.parse(card.dataset.images ?? '[]') as string[]; }
              catch { return card.dataset.image ? [card.dataset.image] : []; }
            })(),
            synopsis: card.dataset.synopsis ?? '',
            ingredients: card.dataset.ingredients ?? '',
            allergens: card.dataset.allergens ?? '',
            sakePairing: card.dataset.sakePairing ?? '',
          },
          origin: { left: rect.left, top: rect.top, width: rect.width, height: rect.height },
          originCard: card,
        },
      }));
    };

    const setCaption = (card: HTMLElement, direction: number) => {
      if (!caption) return;
      const oldContent = currentCaptionContent;
      const forward = direction >= 0;
      oldContent?.classList.add(forward ? 'is-leaving-up' : 'is-leaving-down');

      const content = document.createElement('div');
      content.className = `caption-content is-entering ${forward ? 'from-below' : 'from-above'}`;
      const title = document.createElement('h2');
      title.className = 'caption-title';
      title.textContent = card.dataset.titleEs ?? card.dataset.title ?? '';
      const subtitle = document.createElement('p');
      subtitle.className = 'caption-subtitle';
      subtitle.append(document.createTextNode(`${card.dataset.romaji ?? ''} `));
      const kanji = document.createElement('span');
      kanji.lang = 'ja';
      kanji.textContent = card.dataset.kanji ?? '';
      subtitle.append(kanji);
      const price = document.createElement('p');
      price.className = 'caption-price';
      price.append(document.createTextNode(`$${card.dataset.price ?? ''} `));
      const currency = document.createElement('small');
      currency.textContent = 'MXN';
      price.append(currency);
      content.append(title, subtitle, price);
      caption.append(content);
      currentCaptionContent = content;
      content.getBoundingClientRect();

      requestAnimationFrame(() => {
        content.classList.add('is-current');
        content.classList.remove('is-entering');
      });
      window.setTimeout(() => {
        oldContent?.remove();
        content.classList.remove('from-below', 'from-above');
      }, 520);
    };

    window.addEventListener('pointermove', (event) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (cursor) cursor.style.opacity = '1';
      const target = event.target instanceof Element ? event.target : null;
      cursorMode = isOpen
        ? target?.closest('.detail-modal .close-btn') ? 'modal-close'
          : target?.closest('.detail-modal .cta-btn') ? 'modal-cta'
            : 'modal'
        : target?.closest('.open .cv') ? 'open'
        : target?.closest('.spine') ? 'spine'
        : target?.closest('.btn') ? 'button'
        : 'default';
    });
    window.addEventListener('pointerout', (event) => {
      if (event.relatedTarget === null && cursor) cursor.style.opacity = '0';
    });

    window.addEventListener('takumi:detail-state', (event) => {
      if (!cursor) return;
      const detail = (event as CustomEvent<{ isOpen: boolean }>).detail;
      isOpen = Boolean(detail?.isOpen);
      cursorMode = isOpen ? 'modal' : 'default';
      cursorReturnStart = 0;
      if (isOpen) {
        cursor.classList.remove('cursor--returning');
      } else {
        cursorReturnFrom = cursorScale;
        cursorReturnStart = performance.now();
        cursorMode = 'default';
        cursor.classList.add('cursor--returning');
      }
    });

    const animate = (now: number) => {
      const dt = lastTime ? Math.min((now - lastTime) / 1000, 0.05) : 0;
      lastTime = now;
      // El resorte usa segundos transcurridos; responde igual a 60, 90 y 120 Hz.
      if (!dragging && inertiaActive) {
        T = clamp(T + inertiaVelocity * dt, inertiaOrigin - 1.8, inertiaOrigin + 1.8);
        inertiaVelocity *= Math.exp(-7.5 * dt);
        if (Math.abs(inertiaVelocity) < 0.08) {
          inertiaActive = false;
          inertiaVelocity = 0;
          T = Math.round(T);
        }
      }
      const springK = 3.2;
      s += (T - s) * (prefersReducedMotion ? 1 : 1 - Math.exp(-springK * dt));

      const cursorEase = prefersReducedMotion ? 1 : 1 - Math.exp(-16 * dt);
      cursorX += (pointerX - cursorX) * cursorEase;
      cursorY += (pointerY - cursorY) * cursorEase;
      const targetCursorScale = cursorMode === 'open' ? 1.75 : cursorMode === 'spine' ? 0.72 : cursorMode === 'button' ? 0.55 : cursorMode === 'modal-close' ? 1.14 : cursorMode === 'modal-cta' ? 1.18 : 1;
      if (cursorReturnStart) {
        const progress = Math.min(1, (now - cursorReturnStart) / 300);
        const eased = 1 - Math.pow(1 - progress, 3);
        cursorScale = cursorReturnFrom + (1 - cursorReturnFrom) * eased;
        if (progress === 1) {
          cursorReturnStart = 0;
          cursor?.classList.remove('cursor--returning');
        }
      } else {
        cursorScale += (targetCursorScale - cursorScale) * cursorEase;
      }
      if (cursor) {
        cursor.style.setProperty('--cursor-x', `${cursorX}px`);
        cursor.style.setProperty('--cursor-y', `${cursorY}px`);
        cursor.style.setProperty('--cursor-scale', cursorScale.toFixed(3));
        cursor.classList.toggle('cursor--spine', cursorMode === 'spine');
        cursor.classList.toggle('cursor--button', cursorMode === 'button');
        cursor.classList.toggle('cursor--open', cursorMode === 'open');
        cursor.classList.toggle('cursor--modal', isOpen && cursorMode !== 'modal-close' && cursorMode !== 'modal-cta');
        cursor.classList.toggle('cursor--modal-close', isOpen && cursorMode === 'modal-close');
        cursor.classList.toggle('cursor--modal-cta', isOpen && cursorMode === 'modal-cta');
      }

      const activeCaptionIndex = Math.floor(mod(s + 0.5, count));
      const activeCategory = cards[activeCaptionIndex]?.dataset.category ?? 'specials';
      const watermarkCategory = ['nigiri', 'maki', 'sashimi'].includes(activeCategory) ? activeCategory : 'default';
      if (watermarkCategory !== lastWatermarkCategory) {
        watermarkCategoryLayers.forEach((layer) => layer.classList.toggle('is-active', layer.dataset.watermarkCategory === watermarkCategory));
        lastWatermarkCategory = watermarkCategory;
      }
      if (activeCaptionIndex !== lastCaptionIndex) {
        const direction = shortestDistance(lastCaptionIndex, activeCaptionIndex);
        setCaption(cards[activeCaptionIndex], direction);
        lastCaptionIndex = activeCaptionIndex;
      }

      // Subtle, bounded parallax keeps the monumental type in frame over long circular navigation.
      const scrollDrift = Math.sin((s / count) * Math.PI * 2) * 15;
      const mx = (pointerX / Math.max(window.innerWidth, 1) - 0.5) * 2;
      const my = (pointerY / Math.max(window.innerHeight, 1) - 0.5) * 2;
      watermarkParallax.forEach((kanji) => {
        const layer = kanji.dataset.parallax;
        if (layer === 'left') kanji.style.transform = `translate3d(0, ${-scrollDrift}px, 0) rotate(-7deg)`;
        else if (layer === 'right') kanji.style.transform = `translate3d(${scrollDrift * 0.55}px, 0, 0) rotate(${scrollDrift / 15 * 2}deg)`;
        else if (layer === 'center') kanji.style.transform = `translate3d(-50%, -50%, 0) translate3d(${mx * 13}px, ${my * 13}px, 0) rotate(${mx * 0.6}deg)`;
        else if (layer === 'top') kanji.style.transform = `translate3d(0, ${scrollDrift * 0.28}px, 0) rotate(3deg)`;
        else if (layer === 'bottom') kanji.style.transform = `translate3d(${scrollDrift * -0.32}px, 0, 0) rotate(-4deg)`;
      });

      cards.forEach((card, index) => {
        const r = shortestDistance(s, index);
        const absR = Math.abs(r);
        const side = Math.sign(r);
        // B eases the neighboring spines outward as the active cover opens.
        const easedSpread = 2 * B(clamp(absR, 0, 1)) * d;
        const x = r * ws + side * easedSpread;
        const active = absR < 0.5;
        const open = active ? 1 - absR * 2 : 0;
        const tiltY = open * 90;
        const rotateY = active ? -90 + tiltY : -90;
        const mouseTiltX = Number(card.style.getPropertyValue('--tilt-x')) || 0;
        const mouseTiltY = Number(card.style.getPropertyValue('--tilt-y')) || 0;
        const translateY = active ? -cardHeight * 0.035 : 0;
        const translateZ = active ? 0.2 * cardHeight : 0;
        const rotateZ = active ? -4.5 : 0;
        card.classList.toggle('open', active);
        card.tabIndex = active ? 0 : -1;
        card.style.transform = `translate3d(${x}px, ${translateY}px, ${translateZ}px) rotateX(${mouseTiltX}deg) rotateY(${rotateY + mouseTiltY}deg) rotateZ(${rotateZ}deg)`;
        card.style.zIndex = String(Math.round(1000 - absR * 10));

        const shade = (0.55 + 0.45 * Math.cos(Math.abs(rotateY) * Math.PI / 180)).toFixed(3);
        card.querySelectorAll<HTMLElement>('.sp, .cv').forEach((face) => face.style.setProperty('--shade', shade));
        if (active && shelfShadow) {
          shelfShadow.style.setProperty('--shadow-strength', (0.55 + open * 0.45).toFixed(3));
          shelfShadow.style.setProperty('--shadow-blur', `${18 + open * 22}px`);
          shelfShadow.style.setProperty('--shadow-scale', (1 + open * 0.16).toFixed(3));
        }
      });

      frame = requestAnimationFrame(animate);
    };

    frame = requestAnimationFrame(animate);

    shelf.querySelector('.shelf-section__viewport')?.addEventListener('wheel', (event) => {
      event.preventDefault();
      const wheel = event as WheelEvent;
      const delta = wheel.deltaY || wheel.deltaX;
      const unit = wheel.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16 : wheel.deltaMode === WheelEvent.DOM_DELTA_PAGE ? window.innerHeight : 1;
      const wheelMultiplier = 0.0015;
      T += delta * unit * wheelMultiplier;
    }, { passive: false });

    const viewport = shelf.querySelector<HTMLElement>('.shelf-section__viewport');
    viewport?.addEventListener('pointerdown', (event) => {
      const pointer = event as PointerEvent;
      if (pointer.button !== 0) return;
      dragging = true;
      inertiaActive = false;
      inertiaVelocity = 0;
      dragPointerType = pointer.pointerType;
      dragMoved = false;
      pointerStartX = pointer.clientX;
      pointerStartT = T;
      inertiaOrigin = T;
      lastDragX = pointer.clientX;
      lastDragTime = performance.now();
      viewport.setPointerCapture(pointer.pointerId);
    });
    viewport?.addEventListener('pointermove', (event) => {
      const pointer = event as PointerEvent;
      if (dragging) {
        if (Math.abs(pointer.clientX - pointerStartX) > 6) dragMoved = true;
        const now = performance.now();
        const sampleDt = Math.max((now - lastDragTime) / 1000, 1 / 240);
        const deltaX = pointer.clientX - lastDragX;
        if (dragPointerType === 'touch') {
          const touchMultiplier = 0.4;
          const maxDelta = 1.8;
          const dragDelta = clamp(-(pointer.clientX - pointerStartX) / Math.max(ws, 1) * touchMultiplier, -maxDelta, maxDelta);
          T = pointerStartT + dragDelta;
          inertiaVelocity = clamp(-deltaX / Math.max(ws, 1) * touchMultiplier / sampleDt, -3.6, 3.6);
        } else {
          T = pointerStartT - (pointer.clientX - pointerStartX) / Math.max(ws, 1);
        }
        lastDragX = pointer.clientX;
        lastDragTime = now;
      }
      const target = pointer.target instanceof Element ? pointer.target.closest<HTMLElement>('.tape.open .cv') : null;
      const activeCard = target?.closest<HTMLElement>('.tape');
      if (target && activeCard) {
        const rect = target.getBoundingClientRect();
        const nx = (pointer.clientX - rect.left) / rect.width - 0.5;
        const ny = (pointer.clientY - rect.top) / rect.height - 0.5;
        activeCard.style.setProperty('--tilt-x', `${clamp(-ny * 7, -7, 7)}`);
        activeCard.style.setProperty('--tilt-y', `${clamp(nx * 9, -9, 9)}`);
      }
    });
    viewport?.addEventListener('pointerleave', () => {
      cards.forEach((card) => {
        card.style.removeProperty('--tilt-x');
        card.style.removeProperty('--tilt-y');
      });
    });
    const finishPointer = (event: PointerEvent) => {
      if (dragging && dragPointerType === 'touch' && dragMoved) {
        inertiaActive = Math.abs(inertiaVelocity) >= 0.08;
        if (!inertiaActive) T = Math.round(T);
      }
      dragging = false;
      if (viewport?.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);
    };
    viewport?.addEventListener('pointerup', finishPointer);
    viewport?.addEventListener('pointercancel', finishPointer);

    viewport?.addEventListener('click', (event) => {
      if (dragMoved) {
        dragMoved = false;
        return;
      }
      const target = event.target instanceof Element ? event.target.closest<HTMLElement>('.tape') : null;
      const card = target ?? cards.find((candidate) => {
        if (!candidate.classList.contains('open')) return false;
        const bounds = candidate.querySelector<HTMLElement>('[data-cover]')?.getBoundingClientRect();
        return Boolean(bounds && event.clientX >= bounds.left && event.clientX <= bounds.right && event.clientY >= bounds.top && event.clientY <= bounds.bottom);
      });
      if (card) dispatchOpenDetail(card);
    });

    window.addEventListener('keydown', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest('.detail-modal')) return;
      if (event.key === 'Enter') {
        if (target?.closest('.btn, a, input, textarea, select, [contenteditable="true"]')) return;
        const focusedCard = target?.closest<HTMLElement>('.tape');
        const activeCard = focusedCard?.classList.contains('open') ? focusedCard : cards.find((card) => card.classList.contains('open'));
        if (activeCard) {
          event.preventDefault();
          dispatchOpenDetail(activeCard);
        }
        return;
      }
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      if (document.body.classList.contains('detail-open')) return;
      if (target?.closest('input, textarea, select, [contenteditable="true"]')) return;
      event.preventDefault();
      T += event.key === 'ArrowRight' ? 1 : -1;
    });

    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const category = tab.dataset.category ?? 'all';
      const first = category === 'all'
        ? 0
        : cards.find((card) => card.dataset.category === category)?.dataset.index;
      if (first === undefined) return;
      const firstIndex = Number(first);
      T += shortestDistance(mod(T, count), firstIndex);
      tabs.forEach((candidate) => {
        const selected = candidate === tab;
        candidate.classList.toggle('active', selected);
        candidate.setAttribute('aria-pressed', String(selected));
      });
    }));

    window.addEventListener('resize', () => {
      const nextProbe = document.createElement('div');
      nextProbe.className = 'tape geometry-probe';
      stage.append(nextProbe);
      const nextH = nextProbe.getBoundingClientRect().height || Math.min(330, Math.max(230, window.innerHeight * 0.38));
      nextProbe.remove();
      cardHeight = nextH;
      mobileLayout = window.matchMedia('(max-width: 767px)').matches;
      ws = Math.max(mobileLayout ? 18 : 16, nextH * (mobileLayout ? 0.17 : 0.14));
      d = Math.max(mobileLayout ? 125 : 140, nextH * (mobileLayout ? 0.88 : 0.68));
      shelf.style.setProperty('--H', `${nextH}px`);
      shelf.style.setProperty('--ws', `${ws}px`);
      shelf.style.setProperty('--d', `${d}px`);
    });

    window.addEventListener('pagehide', () => cancelAnimationFrame(frame), { once: true });
  }
</script>

<style>
  .shelf-section { min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; position: relative; perspective: 2200px; background: transparent; }
  .topbar { z-index: 2; display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; padding: 25px 4.2vw; border-bottom: 1px solid var(--rule); }
