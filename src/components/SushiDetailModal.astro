<div class="detail-modal" role="dialog" aria-modal="true" aria-labelledby="detail-title" aria-hidden="true" tabindex="-1">
  <div class="detail-inner">
    <section class="detail-copy" aria-label="Detalle del platillo">
      <button class="detail-close close-btn" type="button" data-close>
        <span>CERRAR / <i lang="ja">閉じる</i></span><b aria-hidden="true">×</b>
      </button>

      <div class="detail-line detail-kanji" data-detail-line><span data-field="kanji">匠・鮨</span></div>
      <div class="detail-line" data-detail-line><h1 id="detail-title" data-field="title">Rollo dragón</h1></div>
      <div class="detail-line" data-detail-line><p class="detail-price"><span data-field="price">$245</span> <small>MXN</small></p></div>
      <div class="detail-line" data-detail-line><div class="detail-badges" data-badges></div></div>
      <div class="detail-line" data-detail-line><p class="detail-description" data-field="synopsis">Anguila glaseada y aguacate sobre un rollo crujiente, con dulzor ahumado y umami largo.</p></div>
      <div class="detail-line" data-detail-line><p class="detail-ingredients"><span>INGREDIENTES</span><b data-field="ingredients">Anguila · aguacate · arroz</b></p></div>
      <div class="detail-line" data-detail-line><div class="sake-copy"><span>MARIDAJE DE SAKE</span><p data-field="sake">Junmai ginjo frío · notas de pera y arroz.</p></div></div>
      <div class="detail-line detail-action-line" data-detail-line>
        <button class="detail-order cta-btn" type="button" data-order>
          <span data-order-label>AÑADIR AL PEDIDO <i lang="ja">注文する</i></span><b aria-hidden="true">↗</b>
        </button>
      </div>
    </section>

    <div class="detail-art" aria-label="Fotografía del platillo">
      <svg viewBox="0 0 474 900" role="img" aria-labelledby="detail-image-title">
        <title id="detail-image-title">Fotografía del platillo</title>
        <defs>
          <filter id="sumi-warp" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.011" numOctaves="2" seed="17" result="ink-noise" />
            <feDisplacementMap in="SourceGraphic" in2="ink-noise" scale="120" xChannelSelector="R" yChannelSelector="G" />
          </filter>
          <filter id="expo-adjacent-tone" x="0" y="0" width="100%" height="100%">
            <feColorMatrix type="saturate" values=".85" />
          </filter>
          <clipPath id="expo-slide-clip" clipPathUnits="userSpaceOnUse">
            <rect x="0" y="0" width="474" height="720" rx="20" />
          </clipPath>
          <mask id="ink-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="474" height="900">
            <rect width="474" height="900" fill="black" />
            <g fill="white" filter="url(#sumi-warp)">
              <circle data-ink-dot cx="116" cy="130" r="0" />
              <circle data-ink-dot cx="355" cy="188" r="0" />
              <circle data-ink-dot cx="237" cy="330" r="0" />
              <circle data-ink-dot cx="103" cy="478" r="0" />
              <circle data-ink-dot cx="377" cy="596" r="0" />
              <circle data-ink-dot cx="213" cy="743" r="0" />
              <circle data-ink-dot cx="402" cy="830" r="0" />
            </g>
          </mask>
        </defs>
        <g data-gallery-backdrop transform="translate(0 0)">
          <rect x="-24" y="-24" width="522" height="948" fill="#e5dfd3" />
          <path d="M-10 690 C120 615 300 760 490 640" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="2" />
          <path d="M-10 720 C120 645 300 790 490 670" fill="none" stroke="rgba(25,27,27,.05)" stroke-width="1" />
        </g>
        <g data-gallery-base mask="url(#ink-mask)" opacity="0"></g>
        <g data-gallery-reveal mask="url(#ink-mask)"></g>
        <rect x=".5" y=".5" width="473" height="899" fill="none" stroke="rgba(25,27,27,.14)" />
      </svg>
      <nav class="gallery-nav-pro" data-gallery-controls aria-label="Galería vertical de fotografías">
        <span class="expo-rail" aria-hidden="true"></span>
        <button class="gallery-arrow gallery-arrow-prev" type="button" data-gallery-prev aria-label="Fotografía anterior, desplazar hacia arriba">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
        </button>
        <div class="expo-readout">
          <span class="expo-counter" data-expo-counter aria-live="polite" aria-label="Fotografía actual"><span class="expo-num" data-expo-num>01</span></span>
          <div class="expo-progress" data-gallery-dots role="group" aria-label="Seleccionar fotografía"></div>
          <span class="expo-total" data-expo-total>03</span>
        </div>
        <button class="gallery-arrow gallery-arrow-next" type="button" data-gallery-next aria-label="Fotografía siguiente, desplazar hacia abajo">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </button>
      </nav>
      <span class="art-caption" lang="ja">季節の一皿</span>
    </div>
  </div>
</div>

<script>
  type DishDetail = {
    id: string;
    title: string;
    titleEs: string;
    romaji: string;
    kanji: string;
    category: string;
    price: string;
    images: string[];
    synopsis: string;
    ingredients: string;
    allergens: string;
    sakePairing: string;
  };
  type DetailOrigin = { left: number; top: number; width: number; height: number };
  type OpenDetailPayload = { dish: DishDetail; origin: DetailOrigin; originCard: HTMLElement };

  const modal = document.querySelector<HTMLElement>('.detail-modal');
  const inner = modal?.querySelector<HTMLElement>('.detail-inner');
  const closeButton = modal?.querySelector<HTMLButtonElement>('[data-close]');
  const orderButton = modal?.querySelector<HTMLButtonElement>('[data-order]');
  const orderLabel = modal?.querySelector<HTMLElement>('[data-order-label]');
  const galleryBase = modal?.querySelector<SVGGElement>('[data-gallery-base]');
  const galleryReveal = modal?.querySelector<SVGGElement>('[data-gallery-reveal]');
  const galleryArt = modal?.querySelector<HTMLElement>('.detail-art');
  const galleryDots = modal?.querySelector<HTMLElement>('[data-gallery-dots]');
  let galleryNumber = modal?.querySelector<HTMLElement>('[data-expo-num]') ?? null;
  const galleryCounter = modal?.querySelector<HTMLElement>('[data-expo-counter]');
  const galleryBackdrop = modal?.querySelector<SVGGElement>('[data-gallery-backdrop]');
  const galleryTotal = modal?.querySelector<HTMLElement>('[data-expo-total]');
  const previousPhotoButton = modal?.querySelector<HTMLButtonElement>('[data-gallery-prev]');
  const nextPhotoButton = modal?.querySelector<HTMLButtonElement>('[data-gallery-next]');
  const inkDots = Array.from(modal?.querySelectorAll<SVGCircleElement>('[data-ink-dot]') ?? []);
  const lineMasks = Array.from(modal?.querySelectorAll<HTMLElement>('[data-detail-line]') ?? []);
  const categoryNames: Record<string, string> = {
    entradas: 'Entradas', nigiri: 'Nigiri', maki: 'Maki', sashimi: 'Sashimi', specials: 'Especiales', bebidas: 'Bebidas', postres: 'Postres',
  };

  if (modal && inner && closeButton && orderButton && galleryBase && galleryReveal && galleryArt && galleryDots && previousPhotoButton && nextPhotoButton) {
    let isOpen = false;
    let activeDish: DishDetail | null = null;
    let origin: DetailOrigin | null = null;
    let originCard: HTMLElement | null = null;
    let openingAnimation: Animation | null = null;
    let inkFrame = 0;
    let transition = 0;
    let previousOverflow = '';
    let galleryImages: string[] = [];
    let galleryIndex = 0;
    let galleryBaseIndex = 0;
    let galleryRequest = 0;
    let touchStartX = 0;
    let touchStartY = 0;
    let touchLastY = 0;
    let touchLastTime = 0;
    let touchVelocity = 0;
    let touchOffset = 0;
    let touchIsVertical = false;
    let wheelLockedUntil = 0;
    let galleryAnimations: Animation[] = [];
    let counterAnimations: Animation[] = [];
    let galleryCounterIndex = -1;
    let galleryCounterRequest = 0;
    const textAnimations: Animation[] = [];

    const setField = (field: string, value: string) => {
      const target = modal.querySelector<HTMLElement>(`[data-field="${field}"]`);
      if (target) target.textContent = value;
    };

    const setBadges = (dish: DishDetail) => {
      const container = modal.querySelector<HTMLElement>('[data-badges]');
      if (!container) return;
      container.replaceChildren();
      const labels = [categoryNames[dish.category] ?? dish.category, ...dish.allergens.split('|').filter(Boolean)];
      if (!dish.allergens) labels.push('Sin alérgenos de declaración obligatoria');
      labels.forEach((label, index) => {
        const badge = document.createElement('span');
        badge.className = index === 0 ? 'detail-badge category-badge' : 'detail-badge';
        badge.textContent = label;
        container.append(badge);
      });
    };

    const cancelDetailEffects = () => {
      cancelAnimationFrame(inkFrame);
      galleryRequest++;
      galleryCounterRequest++;
      galleryAnimations.splice(0).forEach((animation) => animation.cancel());
      counterAnimations.splice(0).forEach((animation) => animation.cancel());
      openingAnimation?.cancel();
      openingAnimation = null;
      textAnimations.splice(0).forEach((animation) => animation.cancel());
    };

    const setBounds = (bounds: DetailOrigin) => {
      modal.style.inset = 'auto';
      modal.style.left = `${bounds.left}px`;
      modal.style.top = `${bounds.top}px`;
      modal.style.width = `${bounds.width}px`;
      modal.style.height = `${bounds.height}px`;
      modal.style.right = 'auto';
      modal.style.bottom = 'auto';
    };

    const revealText = () => {
      textAnimations.splice(0).forEach((animation) => animation.cancel());
      lineMasks.forEach((line, index) => {
        const text = line.firstElementChild as HTMLElement | null;
        if (!text) return;
        textAnimations.push(text.animate(
          [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
          { duration: 620, delay: 250 + index * 75, easing: 'cubic-bezier(.22,.7,.18,1)', fill: 'both' },
        ));
      });
    };

    const slideHeight = 720;
    const slideStep = 736;
    const stageCenterY = 90;
    const svgNamespace = 'http://www.w3.org/2000/svg';

    const setGalleryTrack = (track: SVGGElement, activeIndex: number) => {
      track.replaceChildren();
      track.setAttribute('transform', `translate(0 ${stageCenterY})`);
      track.style.removeProperty('transform');
      track.style.transformBox = 'view-box';
      track.style.transformOrigin = 'top center';

      // Prev/next sit behind the active card; 720 of 900 viewBox units gives 1.25 slides per view.
      const slots = [-1, 1, 0] as const;
      slots.forEach((slot) => {
        const imageIndex = ((activeIndex + slot) % galleryImages.length + galleryImages.length) % galleryImages.length;
        const slide = document.createElementNS(svgNamespace, 'g');
        const isActive = slot === 0;
        const scale = isActive ? 1 : .88;
        slide.setAttribute('class', `expo-slide${isActive ? ' is-active' : ' is-adjacent'}`);
        slide.setAttribute('data-expo-slide', isActive ? 'active' : 'adjacent');
        slide.setAttribute('opacity', isActive ? '1' : '.38');
        if (!isActive) slide.setAttribute('filter', 'url(#expo-adjacent-tone)');
        slide.setAttribute('transform', `translate(0 ${slot * slideStep}) translate(237 360) scale(${scale}) translate(-237 -360)`);

        const photoWindow = document.createElementNS(svgNamespace, 'g');
        photoWindow.setAttribute('clip-path', 'url(#expo-slide-clip)');
        const image = document.createElementNS(svgNamespace, 'image');
        image.dataset.expoImage = '';
        image.setAttribute('x', '0');
        image.setAttribute('y', '0');
        image.setAttribute('width', '474');
        image.setAttribute('height', String(slideHeight));
        image.setAttribute('preserveAspectRatio', 'xMidYMid slice');
        image.setAttribute('href', galleryImages[imageIndex]);
        image.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', galleryImages[imageIndex]);
        image.style.transformBox = 'fill-box';
        image.style.transformOrigin = 'center center';
        photoWindow.append(image);
        slide.append(photoWindow);
        track.append(slide);
      });
    };

    const updateGalleryCounter = (selected: number, direction: number) => {
      if (!galleryCounter || !galleryNumber) return;
      const expoStyles = getComputedStyle(galleryArt);
      const counterDuration = Number.parseFloat(expoStyles.getPropertyValue('--expo-counter-duration')) || 520;
      const easing = expoStyles.getPropertyValue('--expo-ease').trim() || 'cubic-bezier(0.16, 1, 0.3, 1)';
      const request = ++galleryCounterRequest;
      counterAnimations.splice(0).forEach((animation) => animation.cancel());
      galleryCounter.replaceChildren(galleryNumber);
      const next = document.createElement('span');
      next.className = 'expo-num';
      next.dataset.expoNum = '';
      next.textContent = String(selected + 1).padStart(2, '0');
      next.setAttribute('aria-hidden', 'true');
      if (galleryCounterIndex < 0 || direction === 0 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        galleryCounter.replaceChildren(next);
        next.removeAttribute('aria-hidden');
        galleryNumber = next;
        galleryCounterIndex = selected;
        return;
      }
      const current = galleryNumber;
      current.textContent = String(galleryCounterIndex + 1).padStart(2, '0');
      const sign = direction > 0 ? -1 : 1;
      next.style.transform = `translateY(${-sign * 100}%)`;
      galleryCounter.append(next);
      const outgoing = current.animate(
        [{ transform: 'translateY(0)', opacity: 1 }, { transform: `translateY(${sign * 100}%)`, opacity: 0 }],
        { duration: counterDuration * .8, easing, fill: 'forwards' },
      );
      const incoming = next.animate(
        [{ transform: `translateY(${-sign * 100}%)`, opacity: 0 }, { transform: 'translateY(0)', opacity: 1 }],
        { duration: counterDuration, easing, fill: 'forwards' },
      );
      counterAnimations = [outgoing, incoming];
      galleryCounterIndex = selected;
      void Promise.allSettled([outgoing.finished, incoming.finished]).then(() => {
        if (request !== galleryCounterRequest || !galleryCounter.contains(next)) return;
        galleryCounter.replaceChildren(next);
        next.removeAttribute('aria-hidden');
        next.style.removeProperty('transform');
        galleryNumber = next;
        counterAnimations = [];
      });
    };

    const renderGalleryDots = (selected: number, direction = 0) => {
      galleryDots.replaceChildren();
      galleryImages.forEach((_, index) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = `expo-mark${index === selected ? ' is-active' : ''}`;
        dot.setAttribute('aria-label', `Ver fotografía ${index + 1} de ${galleryImages.length}`);
        dot.setAttribute('aria-pressed', String(index === selected));
        dot.addEventListener('click', () => showGalleryImage(index));
        galleryDots.append(dot);
      });
      updateGalleryCounter(selected, direction);
      if (galleryTotal) galleryTotal.textContent = String(galleryImages.length).padStart(2, '0');
      const controlsVisible = galleryImages.length > 1;
      galleryArt.classList.toggle('has-gallery', controlsVisible);
      previousPhotoButton.disabled = !controlsVisible;
      nextPhotoButton.disabled = !controlsVisible;
    };

    const setGalleryImages = (images: string[]) => {
      galleryImages = images.filter(Boolean);
      if (!galleryImages.length) galleryImages = [''];
      galleryIndex = 0;
      galleryBaseIndex = 0;
      setGalleryTrack(galleryBase, 0);
      setGalleryTrack(galleryReveal, 0);
      galleryBase.style.opacity = '0';
      galleryReveal.style.opacity = '1';
      renderGalleryDots(0);
    };

    const revealInk = (onComplete: () => void, duration = 650, stagger = 65, request = ++galleryRequest) => {
      cancelAnimationFrame(inkFrame);
      inkDots.forEach((circle) => circle.setAttribute('r', '0'));
      const startedAt = performance.now();
      const draw = (now: number) => {
        if (!modal.classList.contains('is-open') || request !== galleryRequest) return;
        let finished = true;
        inkDots.forEach((circle, index) => {
          const progress = Math.max(0, Math.min(1, (now - startedAt - index * stagger) / duration));
          const eased = 1 - Math.pow(1 - progress, 3);
          circle.setAttribute('r', String(720 * eased));
          if (progress < 1) finished = false;
        });
        if (!finished) inkFrame = requestAnimationFrame(draw);
        else {
          inkFrame = 0;
          onComplete();
        }
      };
      inkFrame = requestAnimationFrame(draw);
    };

    const finishGalleryReveal = (index: number) => {
      galleryBaseIndex = index;
      setGalleryTrack(galleryBase, index);
      setGalleryTrack(galleryReveal, index);
      galleryBase.style.opacity = '1';
      galleryReveal.style.opacity = '0';
      galleryAnimations.splice(0).forEach((animation) => animation.cancel());
      inkDots.forEach((circle) => circle.setAttribute('r', '0'));
    };

    const showGalleryImage = (index: number, draggedOffset = 0) => {
      if (!isOpen || galleryImages.length < 2) return;
      const next = ((index % galleryImages.length) + galleryImages.length) % galleryImages.length;
      if (next === galleryIndex) return;
      const rawDelta = next - galleryIndex;
      const direction = rawDelta > galleryImages.length / 2 ? -1 : rawDelta < -galleryImages.length / 2 ? 1 : Math.sign(rawDelta);
      const request = ++galleryRequest;
      cancelAnimationFrame(inkFrame);
      galleryAnimations.splice(0).forEach((animation) => animation.cancel());
      finishGalleryReveal(galleryIndex);
      galleryIndex = next;
      setGalleryTrack(galleryReveal, next);
      galleryBase.style.opacity = '1';
      galleryReveal.style.opacity = '1';
      renderGalleryDots(next, direction);
      const expoStyles = getComputedStyle(galleryArt);
      const duration = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 1 : Number.parseFloat(expoStyles.getPropertyValue('--expo-duration')) || 800;
      const easing = expoStyles.getPropertyValue('--expo-ease').trim() || 'cubic-bezier(0.16, 1, 0.3, 1)';
      const outgoing = galleryBase.animate([
        { transform: `translateY(${stageCenterY + draggedOffset}px)`, opacity: 1 },
        { transform: `translateY(${stageCenterY + draggedOffset - direction * slideStep}px)`, opacity: 0 },
      ], { duration, easing, fill: 'forwards' });
      const incoming = galleryReveal.animate([
        { transform: `translateY(${stageCenterY + direction * slideStep + draggedOffset}px)`, opacity: .38 },
        { transform: `translateY(${stageCenterY}px)`, opacity: 1 },
      ], { duration, easing, fill: 'forwards' });
      const outgoingImage = galleryBase.querySelector<SVGImageElement>('[data-expo-slide="active"] [data-expo-image]');
      const incomingImage = galleryReveal.querySelector<SVGImageElement>('[data-expo-slide="active"] [data-expo-image]');
      const outgoingPhoto = outgoingImage?.animate([
        { transform: 'scale(1)', opacity: 1 },
        { transform: 'scale(.9)', opacity: 0 },
      ], { duration, easing, fill: 'forwards' });
      const incomingPhoto = incomingImage?.animate([
        { transform: 'translateY(24px) scale(1.15)', opacity: 0 },
        { transform: 'translateY(0) scale(1)', opacity: 1 },
      ], { duration, easing, fill: 'forwards' });
      const parallax = Number.parseFloat(expoStyles.getPropertyValue('--expo-parallax')) || 18;
      const backdropFrom = direction > 0 ? parallax : -parallax;
      const backdropAnimation = galleryBackdrop?.animate([
        { transform: `translateY(${backdropFrom}px) scale(1.035)`, opacity: .82 },
        { transform: 'translateY(0) scale(1)', opacity: 1 },
      ], { duration: duration * .88, easing, fill: 'forwards' });
      galleryAnimations = [outgoing, incoming, ...(outgoingPhoto ? [outgoingPhoto] : []), ...(incomingPhoto ? [incomingPhoto] : []), ...(backdropAnimation ? [backdropAnimation] : [])];
      let expoDone = false;
      let inkDone = false;
      const complete = () => {
        if (request === galleryRequest && expoDone && inkDone) finishGalleryReveal(next);
      };
      void Promise.allSettled([outgoing.finished, incoming.finished, ...(outgoingPhoto ? [outgoingPhoto.finished] : []), ...(incomingPhoto ? [incomingPhoto.finished] : [])]).then(() => {
        expoDone = true;
        complete();
      });
      // The Expo slide and ink bloom resolve together; the wraparound is modulo-based.
      revealInk(() => {
        inkDone = true;
        complete();
      }, 420, 28, request);
    };

    const openDetail = async (payload: OpenDetailPayload) => {
      if (modal.classList.contains('is-open')) return;
      const sequence = ++transition;
      cancelDetailEffects();
      activeDish = payload.dish;
      origin = payload.origin;
      originCard = payload.originCard;
      setField('kanji', `${payload.dish.kanji} · ${payload.dish.romaji}`);
      setField('title', payload.dish.titleEs);
      setField('price', `$${payload.dish.price}`);
      setField('synopsis', payload.dish.synopsis);
      setField('ingredients', payload.dish.ingredients);
      setField('sake', payload.dish.sakePairing);
      setBadges(payload.dish);
      setGalleryImages(payload.dish.images);
      const svgTitle = modal.querySelector<SVGTitleElement>('#detail-image-title');
      if (svgTitle) svgTitle.textContent = `Fotografía de ${payload.dish.titleEs}`;
      if (orderLabel) orderLabel.textContent = 'AÑADIR AL PEDIDO / 注文する';

      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      document.body.classList.add('detail-open');
      modal.classList.add('is-open');
      isOpen = true;
      window.dispatchEvent(new CustomEvent('takumi:detail-state', { detail: { isOpen } }));
      modal.setAttribute('aria-hidden', 'false');
      modal.style.visibility = 'visible';
      modal.style.pointerEvents = 'auto';
      modal.style.clipPath = 'inset(0 round 8px)';
      modal.style.transform = 'rotate(-4.5deg)';
      modal.style.transformOrigin = 'center center';
      setBounds(payload.origin);
      inner.style.opacity = '0';

      revealInk(() => finishGalleryReveal(0));
      revealText();
      openingAnimation = modal.animate([
        { left: `${payload.origin.left}px`, top: `${payload.origin.top}px`, width: `${payload.origin.width}px`, height: `${payload.origin.height}px`, transform: 'rotate(-4.5deg)', clipPath: 'inset(0 round 8px)' },
        { left: '0px', top: '0px', width: '100vw', height: '100dvh', transform: 'rotate(0deg)', clipPath: 'inset(0)' },
      ], { duration: 1050, easing: 'cubic-bezier(.76,0,.18,1)', fill: 'forwards' });

      const detailFade = inner.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 550, delay: 280, easing: 'ease-out', fill: 'forwards' });
      textAnimations.push(detailFade);
      try {
        await openingAnimation.finished;
      } catch {
        return;
      }
      if (sequence !== transition) return;
      modal.style.left = '0px';
      modal.style.top = '0px';
      modal.style.width = '100vw';
      modal.style.height = '100dvh';
      modal.style.transform = 'rotate(0deg)';
      modal.style.clipPath = 'inset(0)';
      openingAnimation.cancel();
      openingAnimation = null;
      closeButton.focus({ preventScroll: true });
    };

    const closeDetail = async () => {
      if (!modal.classList.contains('is-open') || !origin) return;
      const sequence = ++transition;
      isOpen = false;
      galleryRequest++;
      cancelAnimationFrame(inkFrame);
      window.dispatchEvent(new CustomEvent('takumi:detail-state', { detail: { isOpen } }));
      const currentRect = modal.getBoundingClientRect();
      const currentTransform = getComputedStyle(modal).transform;
      cancelAnimationFrame(inkFrame);
      openingAnimation?.cancel();
      openingAnimation = null;
      setBounds({ left: currentRect.left, top: currentRect.top, width: currentRect.width, height: currentRect.height });
      modal.style.transform = currentTransform;
      modal.style.clipPath = 'inset(0)';
      const animation = modal.animate([
        { left: `${currentRect.left}px`, top: `${currentRect.top}px`, width: `${currentRect.width}px`, height: `${currentRect.height}px`, transform: currentTransform, clipPath: 'inset(0)' },
        { left: `${origin.left}px`, top: `${origin.top}px`, width: `${origin.width}px`, height: `${origin.height}px`, transform: 'rotate(-4.5deg)', clipPath: 'inset(0 round 8px)' },
      ], { duration: 850, easing: 'cubic-bezier(.76,0,.18,1)', fill: 'forwards' });
      try {
        await animation.finished;
      } catch {
        return;
      }
      if (sequence !== transition) return;
      animation.cancel();
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      modal.style.visibility = 'hidden';
      modal.style.pointerEvents = 'none';
      modal.style.removeProperty('inset');
      modal.style.removeProperty('left');
      modal.style.removeProperty('top');
      modal.style.removeProperty('right');
      modal.style.removeProperty('bottom');
      modal.style.removeProperty('width');
      modal.style.removeProperty('height');
      modal.style.removeProperty('transform');
      modal.style.removeProperty('clip-path');
      galleryBase.style.opacity = '0';
      galleryReveal.style.opacity = '1';
      inner.style.opacity = '0';
      document.body.classList.remove('detail-open');
      document.body.style.overflow = previousOverflow;
      textAnimations.splice(0).forEach((effect) => effect.cancel());
      originCard?.focus({ preventScroll: true });
      originCard = null;
      activeDish = null;
      origin = null;
    };

    closeButton.addEventListener('click', () => void closeDetail());
    previousPhotoButton.addEventListener('click', () => showGalleryImage(galleryIndex - 1));
    nextPhotoButton.addEventListener('click', () => showGalleryImage(galleryIndex + 1));
    galleryArt.addEventListener('touchstart', (event) => {
      if (event.touches.length !== 1) return;
      const touch = event.touches[0];
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      touchLastY = touch.clientY;
      touchLastTime = performance.now();
      touchVelocity = 0;
      touchOffset = 0;
      touchIsVertical = false;
    }, { passive: true });
    galleryArt.addEventListener('touchmove', (event) => {
      if (event.touches.length !== 1) return;
      const touch = event.touches[0];
      const dy = touch.clientY - touchStartY;
      const dx = touch.clientX - touchStartX;
      if (!touchIsVertical && Math.abs(dy) > 10 && Math.abs(dy) > Math.abs(dx) * 1.1) touchIsVertical = true;
      if (!touchIsVertical) return;
      event.preventDefault();
      const svg = galleryArt.querySelector('svg');
      const svgHeight = svg?.getBoundingClientRect().height || galleryArt.clientHeight || 900;
      touchOffset = Math.max(-slideStep * .58, Math.min(slideStep * .58, dy * (900 / svgHeight)));
      galleryBase.style.transform = `translateY(${stageCenterY + touchOffset}px)`;
      const now = performance.now();
      const sampleTime = Math.max((now - touchLastTime) / 1000, 1 / 240);
      touchVelocity = (touch.clientY - touchLastY) / sampleTime;
      touchLastY = touch.clientY;
      touchLastTime = now;
    }, { passive: false });
    galleryArt.addEventListener('touchend', (event) => {
      if (!touchIsVertical) return;
      const touch = event.changedTouches[0];
      const total = touch.clientY - touchStartY;
      if (Math.abs(total) > 36) {
        const momentumSteps = Math.abs(touchVelocity) > 1250 ? 2 : 1;
        showGalleryImage(galleryIndex + (total < 0 ? momentumSteps : -momentumSteps), touchOffset);
      } else {
        const returnAnimation = galleryBase.animate(
          [{ transform: `translateY(${stageCenterY + touchOffset}px)` }, { transform: `translateY(${stageCenterY}px)` }],
          { duration: 360, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' },
        );
        galleryAnimations.push(returnAnimation);
        void returnAnimation.finished.then(() => {
          galleryAnimations = galleryAnimations.filter((animation) => animation !== returnAnimation);
          returnAnimation.cancel();
          galleryBase.style.removeProperty('transform');
        }, () => {});
      }
      touchOffset = 0;
      touchIsVertical = false;
    }, { passive: true });
    galleryArt.addEventListener('wheel', (event) => {
      const wheel = event as WheelEvent;
      if (Math.abs(wheel.deltaY) < Math.abs(wheel.deltaX) || Math.abs(wheel.deltaY) < 18) return;
      const now = performance.now();
      if (now < wheelLockedUntil) {
        wheel.preventDefault();
        return;
      }
      wheel.preventDefault();
      wheelLockedUntil = now + 420;
      showGalleryImage(galleryIndex + (wheel.deltaY > 0 ? 1 : -1));
    }, { passive: false });
    modal.addEventListener('click', (event) => {
      if (event.target === modal) void closeDetail();
    });
    orderButton.addEventListener('click', () => {
      if (!activeDish) return;
      window.dispatchEvent(new CustomEvent('takumi:add-to-order', { detail: activeDish }));
      if (orderLabel) {
        orderLabel.textContent = '¡AGREGADO! / 追加されました';
        orderButton.classList.add('is-added');
        window.setTimeout(() => {
          if (!orderLabel.isConnected) return;
          orderLabel.innerHTML = 'AÑADIR AL PEDIDO <i lang="ja">注文する</i>';
          orderButton.classList.remove('is-added');
        }, 1500);
      }
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('is-open')) {
        event.preventDefault();
        void closeDetail();
      }
    });
    window.addEventListener('takumi:open-detail', (event) => void openDetail((event as CustomEvent<OpenDetailPayload>).detail));
  }
</script>

