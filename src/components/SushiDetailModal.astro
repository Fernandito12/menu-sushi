<div class="detail-modal" role="dialog" aria-modal="true" aria-labelledby="detail-title" aria-hidden="true" tabindex="-1">
  <div class="detail-inner">
    <section class="detail-copy" aria-label="Detalle del platillo">
      <button class="detail-close close-btn" type="button" data-close>
        <span>CERRAR / <i lang="ja">閉じる</i></span><b aria-hidden="true">×</b>
      </button>

      <div class="detail-line detail-kanji" data-detail-line><span data-field="kanji">匠・鮨</span></div>
      <div class="detail-line" data-detail-line><h1 id="detail-title" data-field="title">Rollo dragón</h1></div>
      <div class="detail-line" data-detail-line><p class="detail-price"><span data-field="price">$245</span> <small>MXN</small></p></div>
      <div class="detail-line" data-detail-line><div class="detail-badges" data-badges></div></div>
      <div class="detail-line" data-detail-line><p class="detail-description" data-field="synopsis">Anguila glaseada y aguacate sobre un rollo crujiente, con dulzor ahumado y umami largo.</p></div>
      <div class="detail-line" data-detail-line><p class="detail-ingredients"><span>INGREDIENTES</span><b data-field="ingredients">Anguila · aguacate · arroz</b></p></div>
      <div class="detail-line" data-detail-line><div class="sake-copy"><span>MARIDAJE DE SAKE</span><p data-field="sake">Junmai ginjo frío · notas de pera y arroz.</p></div></div>
      <div class="detail-line detail-action-line" data-detail-line>
        <button class="detail-order cta-btn" type="button" data-order>
          <span data-order-label>AÑADIR AL PEDIDO <i lang="ja">注文する</i></span><b aria-hidden="true">↗</b>
        </button>
      </div>
    </section>

    <div class="detail-art" aria-label="Fotografía del platillo">
      <svg viewBox="0 0 474 900" role="img" aria-labelledby="detail-image-title">
        <title id="detail-image-title">Fotografía del platillo</title>
        <defs>
          <filter id="sumi-warp" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.011" numOctaves="2" seed="17" result="ink-noise" />
            <feDisplacementMap in="SourceGraphic" in2="ink-noise" scale="120" xChannelSelector="R" yChannelSelector="G" />
          </filter>
          <mask id="ink-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="474" height="900">
            <rect width="474" height="900" fill="black" />
            <g fill="white" filter="url(#sumi-warp)">
              <circle data-ink-dot cx="116" cy="130" r="0" />
              <circle data-ink-dot cx="355" cy="188" r="0" />
              <circle data-ink-dot cx="237" cy="330" r="0" />
              <circle data-ink-dot cx="103" cy="478" r="0" />
              <circle data-ink-dot cx="377" cy="596" r="0" />
              <circle data-ink-dot cx="213" cy="743" r="0" />
              <circle data-ink-dot cx="402" cy="830" r="0" />
            </g>
          </mask>
        </defs>
        <image data-detail-image href="" x="0" y="0" width="474" height="900" preserveAspectRatio="xMidYMid slice" mask="url(#ink-mask)" />
        <rect x=".5" y=".5" width="473" height="899" fill="none" stroke="rgba(25,27,27,.14)" />
      </svg>
      <span class="art-caption" lang="ja">季節の一皿</span>
    </div>
  </div>
</div>

<script>
  type DishDetail = {
    id: string;
    title: string;
    titleEs: string;
    romaji: string;
    kanji: string;
    category: string;
    price: string;
    imageUrl: string;
    synopsis: string;
    ingredients: string;
    allergens: string;
    sakePairing: string;
  };
  type DetailOrigin = { left: number; top: number; width: number; height: number };
  type OpenDetailPayload = { dish: DishDetail; origin: DetailOrigin; originCard: HTMLElement };

  const modal = document.querySelector<HTMLElement>('.detail-modal');
  const inner = modal?.querySelector<HTMLElement>('.detail-inner');
  const closeButton = modal?.querySelector<HTMLButtonElement>('[data-close]');
  const orderButton = modal?.querySelector<HTMLButtonElement>('[data-order]');
  const orderLabel = modal?.querySelector<HTMLElement>('[data-order-label]');
  const photo = modal?.querySelector<SVGImageElement>('[data-detail-image]');
  const inkDots = Array.from(modal?.querySelectorAll<SVGCircleElement>('[data-ink-dot]') ?? []);
  const lineMasks = Array.from(modal?.querySelectorAll<HTMLElement>('[data-detail-line]') ?? []);
  const categoryNames: Record<string, string> = {
    nigiri: 'Nigiri', maki: 'Maki', sashimi: 'Sashimi', specials: 'Especiales',
  };

  if (modal && inner && closeButton && orderButton && photo) {
    let isOpen = false;
    let activeDish: DishDetail | null = null;
    let origin: DetailOrigin | null = null;
    let originCard: HTMLElement | null = null;
    let openingAnimation: Animation | null = null;
    let inkFrame = 0;
    let transition = 0;
    let previousOverflow = '';
    const textAnimations: Animation[] = [];

    const setField = (field: string, value: string) => {
      const target = modal.querySelector<HTMLElement>(`[data-field="${field}"]`);
      if (target) target.textContent = value;
    };

    const setBadges = (dish: DishDetail) => {
      const container = modal.querySelector<HTMLElement>('[data-badges]');
      if (!container) return;
      container.replaceChildren();
      const labels = [categoryNames[dish.category] ?? dish.category, ...dish.allergens.split('|').filter(Boolean)];
      if (!dish.allergens) labels.push('Sin alérgenos de declaración obligatoria');
      labels.forEach((label, index) => {
        const badge = document.createElement('span');
        badge.className = index === 0 ? 'detail-badge category-badge' : 'detail-badge';
        badge.textContent = label;
        container.append(badge);
      });
    };

    const cancelDetailEffects = () => {
      cancelAnimationFrame(inkFrame);
      openingAnimation?.cancel();
      openingAnimation = null;
      textAnimations.splice(0).forEach((animation) => animation.cancel());
    };

    const setBounds = (bounds: DetailOrigin) => {
      modal.style.inset = 'auto';
      modal.style.left = `${bounds.left}px`;
      modal.style.top = `${bounds.top}px`;
      modal.style.width = `${bounds.width}px`;
      modal.style.height = `${bounds.height}px`;
      modal.style.right = 'auto';
      modal.style.bottom = 'auto';
    };

    const revealText = () => {
      textAnimations.splice(0).forEach((animation) => animation.cancel());
      lineMasks.forEach((line, index) => {
        const text = line.firstElementChild as HTMLElement | null;
        if (!text) return;
        textAnimations.push(text.animate(
          [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
          { duration: 620, delay: 250 + index * 75, easing: 'cubic-bezier(.22,.7,.18,1)', fill: 'both' },
        ));
      });
    };

    const revealInk = () => {
      cancelAnimationFrame(inkFrame);
      inkDots.forEach((circle) => circle.setAttribute('r', '0'));
      const startedAt = performance.now();
      const delay = 65;
      const duration = 650;
      const draw = (now: number) => {
        if (!modal.classList.contains('is-open')) return;
        let finished = true;
        inkDots.forEach((circle, index) => {
          const progress = Math.max(0, Math.min(1, (now - startedAt - index * delay) / duration));
          const eased = 1 - Math.pow(1 - progress, 3);
          circle.setAttribute('r', String(720 * eased));
          if (progress < 1) finished = false;
        });
        if (!finished) inkFrame = requestAnimationFrame(draw);
      };
      inkFrame = requestAnimationFrame(draw);
    };

    const openDetail = async (payload: OpenDetailPayload) => {
      if (modal.classList.contains('is-open')) return;
      const sequence = ++transition;
      cancelDetailEffects();
      activeDish = payload.dish;
      origin = payload.origin;
      originCard = payload.originCard;
      setField('kanji', `${payload.dish.kanji} · ${payload.dish.romaji}`);
      setField('title', payload.dish.titleEs);
      setField('price', `$${payload.dish.price}`);
      setField('synopsis', payload.dish.synopsis);
      setField('ingredients', payload.dish.ingredients);
      setField('sake', payload.dish.sakePairing);
      setBadges(payload.dish);
      photo.setAttribute('href', payload.dish.imageUrl);
      photo.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', payload.dish.imageUrl);
      photo.setAttribute('aria-label', `Fotografía: ${payload.dish.titleEs}`);
      const svgTitle = modal.querySelector<SVGTitleElement>('#detail-image-title');
      if (svgTitle) svgTitle.textContent = `Fotografía de ${payload.dish.titleEs}`;
      if (orderLabel) orderLabel.textContent = 'AÑADIR AL PEDIDO / 注文する';

      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      document.body.classList.add('detail-open');
      modal.classList.add('is-open');
      isOpen = true;
      window.dispatchEvent(new CustomEvent('takumi:detail-state', { detail: { isOpen } }));
      modal.setAttribute('aria-hidden', 'false');
      modal.style.visibility = 'visible';
      modal.style.pointerEvents = 'auto';
      modal.style.clipPath = 'inset(0 round 8px)';
      modal.style.transform = 'rotate(-4.5deg)';
      modal.style.transformOrigin = 'center center';
      setBounds(payload.origin);
      inner.style.opacity = '0';

      revealInk();
      revealText();
      openingAnimation = modal.animate([
        { left: `${payload.origin.left}px`, top: `${payload.origin.top}px`, width: `${payload.origin.width}px`, height: `${payload.origin.height}px`, transform: 'rotate(-4.5deg)', clipPath: 'inset(0 round 8px)' },
        { left: '0px', top: '0px', width: `${window.innerWidth}px`, height: `${window.innerHeight}px`, transform: 'rotate(0deg)', clipPath: 'inset(0)' },
      ], { duration: 1050, easing: 'cubic-bezier(.76,0,.18,1)', fill: 'forwards' });

      const detailFade = inner.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 550, delay: 280, easing: 'ease-out', fill: 'forwards' });
      textAnimations.push(detailFade);
      try {
        await openingAnimation.finished;
      } catch {
        return;
      }
      if (sequence !== transition) return;
      modal.style.left = '0px';
      modal.style.top = '0px';
      modal.style.width = `${window.innerWidth}px`;
      modal.style.height = `${window.innerHeight}px`;
      modal.style.transform = 'rotate(0deg)';
      modal.style.clipPath = 'inset(0)';
      openingAnimation.cancel();
      openingAnimation = null;
      closeButton.focus({ preventScroll: true });
    };

    const closeDetail = async () => {
      if (!modal.classList.contains('is-open') || !origin) return;
      const sequence = ++transition;
      isOpen = false;
      window.dispatchEvent(new CustomEvent('takumi:detail-state', { detail: { isOpen } }));
      const currentRect = modal.getBoundingClientRect();
      const currentTransform = getComputedStyle(modal).transform;
      cancelAnimationFrame(inkFrame);
      openingAnimation?.cancel();
      openingAnimation = null;
      setBounds({ left: currentRect.left, top: currentRect.top, width: currentRect.width, height: currentRect.height });
      modal.style.transform = currentTransform;
      modal.style.clipPath = 'inset(0)';
      const animation = modal.animate([
        { left: `${currentRect.left}px`, top: `${currentRect.top}px`, width: `${currentRect.width}px`, height: `${currentRect.height}px`, transform: currentTransform, clipPath: 'inset(0)' },
        { left: `${origin.left}px`, top: `${origin.top}px`, width: `${origin.width}px`, height: `${origin.height}px`, transform: 'rotate(-4.5deg)', clipPath: 'inset(0 round 8px)' },
      ], { duration: 850, easing: 'cubic-bezier(.76,0,.18,1)', fill: 'forwards' });
      try {
        await animation.finished;
      } catch {
        return;
      }
      if (sequence !== transition) return;
      animation.cancel();
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      modal.style.visibility = 'hidden';
      modal.style.pointerEvents = 'none';
      modal.style.removeProperty('inset');
      modal.style.removeProperty('left');
      modal.style.removeProperty('top');
      modal.style.removeProperty('right');
      modal.style.removeProperty('bottom');
      modal.style.removeProperty('width');
      modal.style.removeProperty('height');
      modal.style.removeProperty('transform');
      modal.style.removeProperty('clip-path');
      inner.style.opacity = '0';
      document.body.classList.remove('detail-open');
      document.body.style.overflow = previousOverflow;
      textAnimations.splice(0).forEach((effect) => effect.cancel());
      originCard?.focus({ preventScroll: true });
      originCard = null;
      activeDish = null;
      origin = null;
    };

    closeButton.addEventListener('click', () => void closeDetail());
    modal.addEventListener('click', (event) => {
      if (event.target === modal) void closeDetail();
    });
    orderButton.addEventListener('click', () => {
      if (!activeDish) return;
      window.dispatchEvent(new CustomEvent('takumi:add-to-order', { detail: activeDish }));
      if (orderLabel) orderLabel.textContent = 'AÑADIDO AL PEDIDO / 追加済み';
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('is-open')) {
        event.preventDefault();
        void closeDetail();
      }
    });
    window.addEventListener('takumi:open-detail', (event) => void openDetail((event as CustomEvent<OpenDetailPayload>).detail));
  }
</script>

<style>
  .detail-modal { position: fixed; z-index: 60; inset: 0; overflow: hidden; visibility: hidden; pointer-events: none; background: #F4F2ED; color: #191B1B; }
  .detail-inner { width: 100%; min-height: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(340px, 474px); align-items: stretch; gap: clamp(34px, 6vw, 100px); padding: clamp(28px, 5vh, 58px) clamp(30px, 7vw, 110px); opacity: 0; }
  .detail-copy { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .detail-close { display: inline-flex; align-items: center; gap: 22px; margin: 0 0 clamp(34px, 6vh, 68px); padding: 0; border: 0; background: none; color: #252a2b; cursor: pointer; font: 500 10px 'Inter Tight', sans-serif; letter-spacing: .12em; }
  .detail-close i, .detail-order i { font: 12px 'Noto Sans JP', sans-serif; font-style: normal; letter-spacing: 0; }
  .detail-close b { color: var(--cobalt); font: 300 24px/1 'Inter Tight', sans-serif; }
  .detail-line { max-width: 620px; width: 100%; overflow: hidden; }
  .detail-kanji { margin-bottom: 10px; color: var(--cobalt); font: 500 14px 'Noto Sans JP', sans-serif; letter-spacing: .08em; }
  #detail-title { margin: 0; font: 400 clamp(42px, 5vw, 60px)/.98 'Newsreader', serif; letter-spacing: -.04em; }
  .detail-price { margin: 16px 0 22px; font: 500 18px 'Newsreader', serif; }
  .detail-price small { color: #77746e; font: 9px 'Inter Tight', sans-serif; letter-spacing: .1em; }
  .detail-badges { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 20px; }
  :global(.detail-badge) { border: 1px solid rgba(25, 27, 27, .17); border-radius: 999px; padding: 6px 10px; color: #5b5d5b; font: 500 9px 'Inter Tight', sans-serif; letter-spacing: .035em; }
  :global(.category-badge) { border-color: rgba(36, 78, 138, .35); color: var(--cobalt); }
  .detail-description { max-width: 520px; margin: 0 0 12px; font: 400 18px/1.5 'Newsreader', serif; }
  .detail-ingredients { display: flex; flex-direction: column; gap: 5px; margin: 0 0 20px; color: #565752; font: 400 12px/1.5 'Inter Tight', sans-serif; }
  .detail-ingredients span, .sake-copy > span { color: #8b877e; font-size: 8px; letter-spacing: .13em; }
  .detail-ingredients b { font-weight: 500; }
  .sake-copy { margin: 0 0 28px; padding-left: 14px; border-left: 1px solid var(--cobalt); }
  .sake-copy p { max-width: 480px; margin: 6px 0 0; color: #4c4e4a; font: 400 14px/1.45 'Newsreader', serif; }
  .detail-order { min-height: 54px; display: flex; align-items: center; justify-content: space-between; gap: 36px; padding: 0 18px; border: 1px solid var(--cobalt); background: var(--cobalt); color: white; cursor: pointer; font: 500 10px 'Inter Tight', sans-serif; letter-spacing: .1em; }
  .detail-order i { margin-left: 8px; }
  .detail-order b { font: 400 16px 'Inter Tight', sans-serif; }
  .detail-close:focus-visible, .detail-order:focus-visible { outline: 2px solid var(--cobalt); outline-offset: 4px; }
  .detail-art { position: relative; min-width: 0; min-height: min(82vh, 900px); display: grid; place-items: center; }
  .detail-art svg { display: block; width: min(100%, 474px); height: min(82vh, 900px); overflow: visible; background: #e5dfd3; }
  .art-caption { position: absolute; right: 14px; bottom: 12px; color: rgba(25, 27, 27, .62); font: 11px 'Noto Sans JP', sans-serif; writing-mode: vertical-rl; }
  @media (max-width: 767px) {
    .detail-modal { overflow-x: hidden; overflow-y: auto; overscroll-behavior-y: contain; -webkit-overflow-scrolling: touch; }
    .detail-inner { min-height: 100svh; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto; gap: 22px; padding: 84px 20px 40px; }
    .detail-art { grid-row: 1; grid-column: 1; min-height: 42svh; height: 42svh; }
    .detail-art svg { width: min(100%, 474px); height: 42svh; }
    .detail-copy { grid-row: 2; grid-column: 1; justify-content: flex-start; }
    .detail-close { position: fixed; z-index: 70; top: 10px; left: 12px; min-height: 44px; margin: 0; padding: 0 12px; border: 1px solid rgba(25, 27, 27, .14); border-radius: 999px; background: rgba(244, 242, 237, .94); box-shadow: 0 4px 16px rgba(25, 27, 27, .06); }
    #detail-title { font-size: 44px; }
    .detail-price { margin: 10px 0 14px; }
    .detail-badges { margin-bottom: 12px; }
    .detail-description { font-size: 16px; }
    .detail-ingredients { margin-bottom: 13px; }
    .sake-copy { margin-bottom: 18px; }
    .detail-action-line { position: sticky; z-index: 70; bottom: 20px; overflow: visible; padding-top: 10px; background: linear-gradient(180deg, rgba(244, 242, 237, 0), #F4F2ED 28%); }
    .detail-order { position: sticky; bottom: 20px; width: 100%; min-height: 56px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .detail-close, .detail-order { transition: none; }
  }
</style>
