<div class="detail-modal" role="dialog" aria-modal="true" aria-labelledby="detail-title" aria-hidden="true" tabindex="-1">
  <div class="detail-inner">
    <section class="detail-copy modal-info" aria-label="Detalle del platillo">
      <button class="detail-close close-btn" type="button" data-close>
        <span>CERRAR / <i lang="ja">閉じる</i></span><b aria-hidden="true">×</b>
      </button>

      <div class="detail-line detail-kanji" data-detail-line><span data-field="kanji">匠・鮨</span></div>
      <div class="detail-line" data-detail-line><div class="detail-badges" data-badges></div></div>
      <div class="detail-line" data-detail-line><h1 id="detail-title" data-field="title">Rollo dragón</h1></div>
      <div class="detail-line" data-detail-line><p class="detail-price"><span data-field="price">$245</span> <small>MXN</small></p></div>
      <div class="detail-line" data-detail-line><p class="detail-description" data-field="synopsis">Anguila glaseada y aguacate sobre un rollo crujiente, con dulzor ahumado y umami largo.</p></div>
      <div class="detail-line" data-detail-line><p class="detail-ingredients"><span>INGREDIENTES</span><b data-field="ingredients">Anguila · aguacate · arroz</b></p></div>
      <div class="detail-line" data-detail-line><div class="sake-copy"><span>MARIDAJE DE SAKE</span><p data-field="sake">Junmai ginjo frío · notas de pera y arroz.</p></div></div>
      <div class="detail-line detail-action-line" data-detail-line>
        <button class="detail-order cta-btn" type="button" data-order>
          <span data-order-label>AÑADIR AL PEDIDO <i lang="ja">注文する</i></span><b aria-hidden="true">↗</b>
        </button>
      </div>
    </section>

    <div class="detail-art modal-gallery" aria-label="Fotografías del platillo">
      <div class="swiper modal-gallery-swiper" data-gallery-swiper aria-live="polite">
        <div class="swiper-wrapper" data-gallery-wrapper></div>
      </div>
      <nav class="gallery-nav-pro gallery-sidebar" data-gallery-controls aria-label="Galería vertical de fotografías">
        <span class="expo-rail" aria-hidden="true"></span>
        <button class="gallery-arrow gallery-arrow-prev" type="button" data-gallery-prev aria-label="Fotografía anterior, desplazar hacia arriba">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
        </button>
        <div class="expo-readout">
          <span class="expo-counter" data-expo-counter aria-live="polite" aria-label="Fotografía actual"><span class="expo-num" data-expo-num>01</span></span>
          <div class="expo-progress" data-gallery-dots role="group" aria-label="Seleccionar fotografía"></div>
          <span class="expo-total" data-expo-total>03</span>
        </div>
        <button class="gallery-arrow gallery-arrow-next" type="button" data-gallery-next aria-label="Fotografía siguiente, desplazar hacia abajo">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </button>
      </nav>
      <span class="art-caption" lang="ja">季節の一皿</span>
    </div>
  </div>
</div>

<script>
  import Swiper from '../../nolimits4web-swiper-e043db5/src/swiper.ts';
  import EffectCreative from '../../nolimits4web-swiper-e043db5/src/modules/effect-creative/effect-creative.ts';
  import Navigation from '../../nolimits4web-swiper-e043db5/src/modules/navigation/navigation.ts';
  import Pagination from '../../nolimits4web-swiper-e043db5/src/modules/pagination/pagination.ts';
  import '../../nolimits4web-swiper-e043db5/src/swiper.css';
  import '../../nolimits4web-swiper-e043db5/src/modules/effect-creative/effect-creative.css';
  import '../../nolimits4web-swiper-e043db5/src/modules/navigation/navigation.css';
  import '../../nolimits4web-swiper-e043db5/src/modules/pagination/pagination.css';

  type DishDetail = {
    id: string; title: string; titleEs: string; romaji: string; kanji: string; category: string;
    price: string; images: string[]; synopsis: string; ingredients: string; allergens: string; sakePairing: string;
  };
  type DetailOrigin = { left: number; top: number; width: number; height: number };
  type OpenDetailPayload = { dish: DishDetail; origin: DetailOrigin; originCard: HTMLElement };
  type GallerySwiper = InstanceType<typeof Swiper>;

  const modal = document.querySelector<HTMLElement>('.detail-modal');
  const inner = modal?.querySelector<HTMLElement>('.detail-inner');
  const closeButton = modal?.querySelector<HTMLButtonElement>('[data-close]');
  const orderButton = modal?.querySelector<HTMLButtonElement>('[data-order]');
  const orderLabel = modal?.querySelector<HTMLElement>('[data-order-label]');
  const galleryArt = modal?.querySelector<HTMLElement>('.detail-art');
  const swiperElement = modal?.querySelector<HTMLElement>('[data-gallery-swiper]');
  const galleryWrapper = modal?.querySelector<HTMLElement>('[data-gallery-wrapper]');
  const galleryDots = modal?.querySelector<HTMLElement>('[data-gallery-dots]');
  const galleryCounter = modal?.querySelector<HTMLElement>('[data-expo-counter]');
  const galleryTotal = modal?.querySelector<HTMLElement>('[data-expo-total]');
  const previousPhotoButton = modal?.querySelector<HTMLButtonElement>('[data-gallery-prev]');
  const nextPhotoButton = modal?.querySelector<HTMLButtonElement>('[data-gallery-next]');
  const lineMasks = Array.from(modal?.querySelectorAll<HTMLElement>('[data-detail-line]') ?? []);
  const categoryNames: Record<string, string> = {
    entradas: 'Entradas', nigiri: 'Nigiri', maki: 'Maki', sashimi: 'Sashimi', specials: 'Especiales', bebidas: 'Bebidas', postres: 'Postres',
  };

  if (modal && inner && closeButton && orderButton && galleryArt && swiperElement && galleryWrapper && galleryDots && galleryCounter && galleryTotal && previousPhotoButton && nextPhotoButton) {
    let isOpen = false;
    let activeDish: DishDetail | null = null;
    let origin: DetailOrigin | null = null;
    let originCard: HTMLElement | null = null;
    let openingAnimation: Animation | null = null;
    let inkFrame = 0;
    let transition = 0;
    let previousOverflow = '';
    let galleryImages: string[] = [];
    let galleryIndex = 0;
    let gallerySwiper: GallerySwiper | null = null;
    let wheelLockedUntil = 0;
    let counterAnimation: Animation | null = null;
    let textAnimations: Animation[] = [];
    let inkRequest = 0;
    let galleryId = 0;
    let previousCounterIndex = -1;

    const setField = (field: string, value: string) => {
      const target = modal.querySelector<HTMLElement>(`[data-field="${field}"]`);
      if (target) target.textContent = value;
    };

    const setBadges = (dish: DishDetail) => {
      const container = modal.querySelector<HTMLElement>('[data-badges]');
      if (!container) return;
      container.replaceChildren();
      const labels = [categoryNames[dish.category] ?? dish.category, ...dish.allergens.split('|').filter(Boolean)];
      if (!dish.allergens) labels.push('Sin alérgenos de declaración obligatoria');
      labels.forEach((label, index) => {
        const badge = document.createElement('span');
        badge.className = index === 0 ? 'detail-badge category-badge' : 'detail-badge';
        badge.textContent = label;
        container.append(badge);
      });
    };

    const cancelDetailEffects = () => {
      cancelAnimationFrame(inkFrame);
      inkRequest++;
      counterAnimation?.cancel();
      counterAnimation = null;
      openingAnimation?.cancel();
      openingAnimation = null;
      textAnimations.forEach((animation) => animation.cancel());
      textAnimations = [];
    };

    const setBounds = (bounds: DetailOrigin) => {
      modal.style.inset = 'auto';
      modal.style.left = `${bounds.left}px`;
      modal.style.top = `${bounds.top}px`;
      modal.style.width = `${bounds.width}px`;
      modal.style.height = `${bounds.height}px`;
      modal.style.right = 'auto';
      modal.style.bottom = 'auto';
    };

    const revealText = () => {
      lineMasks.forEach((line, index) => {
        const text = line.firstElementChild as HTMLElement | null;
        if (text) textAnimations.push(text.animate(
          [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
          { duration: 620, delay: 250 + index * 75, easing: 'cubic-bezier(.22,.7,.18,1)', fill: 'both' },
        ));
      });
    };

    const createSlide = (url: string, index: number) => {
      const uid = `takumi-ink-${++galleryId}`;
      const slide = document.createElement('div');
      slide.className = 'swiper-slide';
      slide.setAttribute('role', 'group');
      slide.setAttribute('aria-label', `Fotografía ${index + 1} de ${galleryImages.length}`);

      const card = document.createElement('div');
      card.className = 'swiper-slide-card';
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('viewBox', '0 0 474 900');
      svg.setAttribute('preserveAspectRatio', 'xMidYMid slice');
      svg.setAttribute('role', 'img');
      svg.setAttribute('aria-label', `Fotografía ${index + 1} del platillo`);

      const defs = document.createElementNS(svg.namespaceURI, 'defs');
      const filter = document.createElementNS(svg.namespaceURI, 'filter');
      filter.id = `${uid}-warp`;
      filter.setAttribute('x', '-20%'); filter.setAttribute('y', '-20%');
      filter.setAttribute('width', '140%'); filter.setAttribute('height', '140%');
      filter.setAttribute('color-interpolation-filters', 'sRGB');
      const turbulence = document.createElementNS(svg.namespaceURI, 'feTurbulence');
      turbulence.setAttribute('type', 'fractalNoise'); turbulence.setAttribute('baseFrequency', '0.011');
      turbulence.setAttribute('numOctaves', '2'); turbulence.setAttribute('seed', String(index + 17));
      turbulence.setAttribute('result', 'ink-noise');
      const displacement = document.createElementNS(svg.namespaceURI, 'feDisplacementMap');
      displacement.setAttribute('in', 'SourceGraphic'); displacement.setAttribute('in2', 'ink-noise');
      displacement.setAttribute('scale', '120'); displacement.setAttribute('xChannelSelector', 'R'); displacement.setAttribute('yChannelSelector', 'G');
      filter.append(turbulence, displacement);
      const mask = document.createElementNS(svg.namespaceURI, 'mask');
      mask.id = `${uid}-mask`;
      mask.setAttribute('maskUnits', 'userSpaceOnUse'); mask.setAttribute('x', '0'); mask.setAttribute('y', '0');
      mask.setAttribute('width', '474'); mask.setAttribute('height', '900');
      const black = document.createElementNS(svg.namespaceURI, 'rect');
      black.setAttribute('width', '474'); black.setAttribute('height', '900'); black.setAttribute('fill', 'black');
      const ink = document.createElementNS(svg.namespaceURI, 'g');
      ink.setAttribute('fill', 'white'); ink.setAttribute('filter', `url(#${filter.id})`);
      const points = [[116,130],[355,188],[237,330],[103,478],[377,596],[213,743],[402,830]];
      points.forEach(([cx, cy]) => {
        const circle = document.createElementNS(svg.namespaceURI, 'circle');
        circle.dataset.inkDot = ''; circle.setAttribute('cx', String(cx)); circle.setAttribute('cy', String(cy));
        circle.setAttribute('r', index === 0 ? '0' : '720'); ink.append(circle);
      });
      mask.append(black, ink); defs.append(filter, mask);
      const image = document.createElementNS(svg.namespaceURI, 'image');
      image.classList.add('swiper-slide-img');
      image.setAttribute('x', '0'); image.setAttribute('y', '0'); image.setAttribute('width', '474'); image.setAttribute('height', '900');
      image.setAttribute('preserveAspectRatio', 'xMidYMid slice'); image.setAttribute('href', url);
      image.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', url);
      image.setAttribute('mask', `url(#${mask.id})`);
      const border = document.createElementNS(svg.namespaceURI, 'rect');
      border.setAttribute('x', '.5'); border.setAttribute('y', '.5'); border.setAttribute('width', '473'); border.setAttribute('height', '899');
      border.setAttribute('fill', 'none'); border.setAttribute('stroke', 'rgba(25,27,27,.14)');
      svg.append(defs, image, border); card.append(svg); slide.append(card);
      return slide;
    };

    const updateCounter = (selected: number) => {
      const current = galleryCounter.querySelector<HTMLElement>('[data-expo-num]');
      const nextValue = String(selected + 1).padStart(2, '0');
      if (!current || previousCounterIndex < 0 || previousCounterIndex === selected || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const number = document.createElement('span');
        number.className = 'expo-num'; number.dataset.expoNum = ''; number.textContent = nextValue;
        galleryCounter.replaceChildren(number);
      } else {
        counterAnimation?.cancel();
        const next = document.createElement('span');
        next.className = 'expo-num'; next.dataset.expoNum = ''; next.textContent = nextValue;
        next.setAttribute('aria-hidden', 'true');
        const direction = selected > previousCounterIndex ? -1 : 1;
        next.style.transform = `translateY(${direction * 100}%)`;
        galleryCounter.append(next);
        const out = current.animate([{ transform: 'translateY(0)', opacity: 1 }, { transform: `translateY(${-direction * 100}%)`, opacity: 0 }], { duration: 300, easing: 'cubic-bezier(0.16,1,0.3,1)', fill: 'forwards' });
        const enter = next.animate([{ transform: `translateY(${direction * 100}%)`, opacity: 0 }, { transform: 'translateY(0)', opacity: 1 }], { duration: 420, easing: 'cubic-bezier(0.16,1,0.3,1)', fill: 'forwards' });
        counterAnimation = enter;
        void Promise.allSettled([out.finished, enter.finished]).then(() => {
          if (!galleryCounter.contains(next)) return;
          galleryCounter.replaceChildren(next); next.removeAttribute('aria-hidden'); next.style.removeProperty('transform');
        });
      }
      galleryCounter.setAttribute('aria-label', `Fotografía ${nextValue} de ${String(galleryImages.length).padStart(2, '0')}`);
      previousCounterIndex = selected;
    };

    const revealActiveInk = () => {
      cancelAnimationFrame(inkFrame);
      const request = ++inkRequest;
      const slide = gallerySwiper?.slides[gallerySwiper.activeIndex];
      if (!slide) return;
      const circles = Array.from(slide.querySelectorAll<SVGCircleElement>('[data-ink-dot]'));
      circles.forEach((circle) => circle.setAttribute('r', '0'));
      const started = performance.now();
      const draw = (now: number) => {
        if (request !== inkRequest || !isOpen) return;
        let complete = true;
        circles.forEach((circle, index) => {
          const p = Math.max(0, Math.min(1, (now - started - index * 35) / 560));
          circle.setAttribute('r', String(720 * (1 - Math.pow(1 - p, 3))));
          if (p < 1) complete = false;
        });
        if (!complete) inkFrame = requestAnimationFrame(draw);
      };
      inkFrame = requestAnimationFrame(draw);
    };

    const updateProgress = (swiper: GallerySwiper) => {
      swiper.slides.forEach((slide) => {
        const progress = slide.progress ?? 0;
        const distance = Math.abs(progress);
        const img = slide.querySelector<SVGImageElement>('.swiper-slide-img');
        if (img) img.style.transform = `scale(${1 + distance * .15}) translateY(${progress * 10}%)`;
      });
    };

    const setGalleryImages = (images: string[]) => {
      galleryImages = images.filter(Boolean);
      if (!galleryImages.length) galleryImages = [''];
      gallerySwiper?.destroy(true, true);
      gallerySwiper = null;
      galleryIndex = 0;
      previousCounterIndex = -1;
      galleryWrapper.replaceChildren(...galleryImages.map(createSlide));
      galleryTotal.textContent = String(galleryImages.length).padStart(2, '0');
      galleryArt.classList.toggle('has-gallery', galleryImages.length > 1);
      previousPhotoButton.disabled = galleryImages.length < 2;
      nextPhotoButton.disabled = galleryImages.length < 2;
      galleryDots.setAttribute('aria-label', `Elegir entre ${galleryImages.length} fotografías`);
      gallerySwiper = new Swiper(swiperElement, {
        modules: [EffectCreative, Navigation, Pagination],
        direction: 'vertical', loop: galleryImages.length > 1, speed: 800,
        grabCursor: true, centeredSlides: true, slidesPerView: 1.25, spaceBetween: 16,
        watchSlidesProgress: true, touchRatio: 1.2, resistanceRatio: .85,
        effect: 'creative',
        creativeEffect: {
          limitProgress: 1,
          prev: { translate: [0, '-85%', -100], scale: .88, opacity: .38 },
          next: { translate: [0, '85%', -100], scale: .88, opacity: .38 },
        },
        navigation: { prevEl: previousPhotoButton, nextEl: nextPhotoButton },
        pagination: {
          el: galleryDots, clickable: true, bulletClass: 'expo-mark', bulletActiveClass: 'is-active',
          renderBullet(index, className) {
            return `<button type="button" class="${className}" aria-label="Ver fotografía ${index + 1}" aria-pressed="false"></button>`;
          },
        },
        on: {
          init(swiper) { updateProgress(swiper); updateCounter(swiper.realIndex); },
          progress(swiper) { updateProgress(swiper); },
          setTranslate(swiper) { updateProgress(swiper); },
          setTransition(swiper, duration) {
            swiper.slides.forEach((slide) => {
              slide.style.transitionDuration = `${duration}ms`;
              const card = slide.querySelector<HTMLElement>('.swiper-slide-card');
              const img = slide.querySelector<SVGImageElement>('.swiper-slide-img');
              if (card) card.style.transitionDuration = `${duration}ms`;
              if (img) img.style.transitionDuration = `${duration}ms`;
            });
          },
          slideChange(swiper) {
            galleryIndex = swiper.realIndex;
            updateCounter(galleryIndex);
            swiper.pagination?.bullets.forEach((bullet, index) => bullet.setAttribute('aria-pressed', String(index === galleryIndex)));
            if (isOpen) revealActiveInk();
          },
        },
      });
      gallerySwiper.slides.forEach((slide) => {
        const img = slide.querySelector<SVGImageElement>('.swiper-slide-img');
        if (img) { const preload = new Image(); preload.src = img.getAttribute('href') || ''; }
      });
    };

    const setActiveBounds = (bounds: DetailOrigin) => setBounds(bounds);
    const openDetail = async (payload: OpenDetailPayload) => {
      if (modal.classList.contains('is-open')) return;
      const sequence = ++transition;
      cancelDetailEffects();
      activeDish = payload.dish; origin = payload.origin; originCard = payload.originCard;
      setField('kanji', `${payload.dish.kanji} · ${payload.dish.romaji}`);
      setField('title', payload.dish.titleEs); setField('price', `$${payload.dish.price}`);
      setField('synopsis', payload.dish.synopsis); setField('ingredients', payload.dish.ingredients); setField('sake', payload.dish.sakePairing);
      setBadges(payload.dish); setGalleryImages(payload.dish.images);
      if (orderLabel) orderLabel.innerHTML = 'AÑADIR AL PEDIDO <i lang="ja">注文する</i>';
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden'; document.body.classList.add('detail-open');
      modal.classList.add('is-open'); isOpen = true;
      window.dispatchEvent(new CustomEvent('takumi:detail-state', { detail: { isOpen } }));
      modal.setAttribute('aria-hidden', 'false'); modal.style.visibility = 'visible'; modal.style.pointerEvents = 'auto';
      modal.style.clipPath = 'inset(0 round 8px)'; modal.style.transform = 'rotate(-4.5deg)'; modal.style.transformOrigin = 'center center';
      setActiveBounds(payload.origin); inner.style.opacity = '0';
      revealActiveInk(); revealText();
      openingAnimation = modal.animate([
        { left: `${payload.origin.left}px`, top: `${payload.origin.top}px`, width: `${payload.origin.width}px`, height: `${payload.origin.height}px`, transform: 'rotate(-4.5deg)', clipPath: 'inset(0 round 8px)' },
        { left: '0px', top: '0px', width: '100vw', height: '100dvh', transform: 'rotate(0deg)', clipPath: 'inset(0)' },
      ], { duration: 1050, easing: 'cubic-bezier(.76,0,.18,1)', fill: 'forwards' });
      textAnimations.push(inner.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 550, delay: 280, easing: 'ease-out', fill: 'forwards' }));
      try { await openingAnimation.finished; } catch { return; }
      if (sequence !== transition) return;
      modal.style.left = '0px'; modal.style.top = '0px'; modal.style.width = '100vw'; modal.style.height = '100dvh';
      modal.style.transform = 'rotate(0deg)'; modal.style.clipPath = 'inset(0)'; openingAnimation.cancel(); openingAnimation = null;
      closeButton.focus({ preventScroll: true });
    };

    const closeDetail = async () => {
      if (!modal.classList.contains('is-open') || !origin) return;
      const sequence = ++transition;
      isOpen = false; cancelAnimationFrame(inkFrame); inkRequest++;
      window.dispatchEvent(new CustomEvent('takumi:detail-state', { detail: { isOpen } }));
      const currentRect = modal.getBoundingClientRect();
      const currentTransform = getComputedStyle(modal).transform;
      openingAnimation?.cancel(); openingAnimation = null;
      setBounds({ left: currentRect.left, top: currentRect.top, width: currentRect.width, height: currentRect.height });
      modal.style.transform = currentTransform; modal.style.clipPath = 'inset(0)';
      const animation = modal.animate([
        { left: `${currentRect.left}px`, top: `${currentRect.top}px`, width: `${currentRect.width}px`, height: `${currentRect.height}px`, transform: currentTransform, clipPath: 'inset(0)' },
        { left: `${origin.left}px`, top: `${origin.top}px`, width: `${origin.width}px`, height: `${origin.height}px`, transform: 'rotate(-4.5deg)', clipPath: 'inset(0 round 8px)' },
      ], { duration: 850, easing: 'cubic-bezier(.76,0,.18,1)', fill: 'forwards' });
      try { await animation.finished; } catch { return; }
      if (sequence !== transition) return;
      animation.cancel(); modal.classList.remove('is-open'); modal.setAttribute('aria-hidden', 'true');
      modal.style.visibility = 'hidden'; modal.style.pointerEvents = 'none';
      ['inset','left','top','right','bottom','width','height','transform','clip-path'].forEach((property) => modal.style.removeProperty(property));
      inner.style.opacity = '0'; document.body.classList.remove('detail-open'); document.body.style.overflow = previousOverflow;
      textAnimations.forEach((effect) => effect.cancel()); textAnimations = [];
      originCard?.focus({ preventScroll: true }); originCard = null; activeDish = null; origin = null;
    };

    closeButton.addEventListener('click', () => void closeDetail());
    galleryArt.addEventListener('wheel', (event) => {
      const wheel = event as WheelEvent;
      if (Math.abs(wheel.deltaY) < Math.abs(wheel.deltaX) || Math.abs(wheel.deltaY) < 18) return;
      const now = performance.now();
      if (now < wheelLockedUntil) { wheel.preventDefault(); return; }
      wheel.preventDefault(); wheelLockedUntil = now + 420;
      if (wheel.deltaY > 0) gallerySwiper?.slideNext(); else gallerySwiper?.slidePrev();
    }, { passive: false });
    modal.addEventListener('click', (event) => { if (event.target === modal) void closeDetail(); });
    orderButton.addEventListener('click', () => {
      if (!activeDish) return;
      window.dispatchEvent(new CustomEvent('takumi:add-to-order', { detail: activeDish }));
      if (orderLabel) {
        orderLabel.textContent = '¡AGREGADO! / 追加されました'; orderButton.classList.add('is-added');
        window.setTimeout(() => {
          if (!orderLabel.isConnected) return;
          orderLabel.innerHTML = 'AÑADIR AL PEDIDO <i lang="ja">注文する</i>'; orderButton.classList.remove('is-added');
        }, 1500);
      }
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('is-open')) { event.preventDefault(); void closeDetail(); }
    });
    window.addEventListener('takumi:open-detail', (event) => void openDetail((event as CustomEvent<OpenDetailPayload>).detail));
  }
</script>

<style>
  .detail-modal { position: fixed; z-index: 60; inset: 0; overflow: hidden; visibility: hidden; pointer-events: none; background: #F4F2ED; color: #191B1B; }
  .detail-inner { width: 100%; min-height: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(340px, 474px); align-items: stretch; gap: clamp(34px, 6vw, 100px); padding: clamp(28px, 5vh, 58px) clamp(30px, 7vw, 110px); opacity: 0; }
  .detail-copy { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .detail-close { display: inline-flex; align-items: center; gap: 22px; margin: 0 0 clamp(34px, 6vh, 68px); padding: 0; border: 0; background: none; color: #252a2b; cursor: pointer; font: 500 10px 'Inter Tight', sans-serif; letter-spacing: .12em; }
  .detail-close i, .detail-order i { font: 12px 'Noto Sans JP', sans-serif; font-style: normal; letter-spacing: 0; }
  .detail-close b { color: var(--cobalt); font: 300 24px/1 'Inter Tight', sans-serif; }
  .detail-line { max-width: 620px; width: 100%; overflow: hidden; }
